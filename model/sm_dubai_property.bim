            "expression": "VAR asOf = CALCULATE ( MAX ( FCT_TRANSACTIONS[TRANSACTION_DATE] ), REMOVEFILTERS () ) VAR endDate = DIM_PROJECT[PROJECT_END_DATE] RETURN SWITCH ( TRUE (), ISBLANK ( endDate ), \"No date\", endDate < asOf, \"Overdue\", FORMAT ( YEAR ( endDate ), \"0\" ) )",
