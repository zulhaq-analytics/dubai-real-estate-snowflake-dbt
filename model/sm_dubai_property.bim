            "isDataTypeInferred": true,
            "expression": "VAR u = MART_PROJECT_ABSORPTION[NO_OF_UNITS] RETURN SWITCH ( TRUE (), u < 100, \"Under 100 units\", u < 200, \"100–199\", u < 500, \"200–499\", u < 1000, \"500–999\", \"1,000+\" )",
