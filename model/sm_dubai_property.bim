          {
            "name": "Dirham Symbol Navy",
            "expression": "\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 344.84 299.91'><path fill='%230f3661' d='M342.14,140.96l2.7,2.54v-7.72c0-17-11.92-30.84-26.56-30.84h-23.41C278.49,36.7,222.69,0,139.68,0c-52.86,0-59.65,0-109.71,0,0,0,15.03,12.63,15.03,52.4v52.58h-27.68c-5.38,0-10.43-2.08-14.61-6.01l-2.7-2.54v7.72c0,17.01,11.92,30.84,26.56,30.84h18.44s0,29.99,0,29.99h-27.68c-5.38,0-10.43-2.07-14.61-6.01l-2.7-2.54v7.71c0,17,11.92,30.82,26.56,30.82h18.44s0,54.89,0,54.89c0,38.65-15.03,50.06-15.03,50.06h109.71c85.62,0,139.64-36.96,155.38-104.98h32.46c5.38,0,10.43,2.07,14.61,6l2.7,2.54v-7.71c0-17-11.92-30.83-26.56-30.83h-18.9c.32-4.88.49-9.87.49-15s-.18-10.11-.51-14.99h28.17c5.37,0,10.43,2.07,14.61,6.01ZM89.96,15.01h45.86c61.7,0,97.44,27.33,108.1,89.94l-153.96.02V15.01ZM136.21,284.93h-46.26v-89.98l153.87-.02c-9.97,56.66-42.07,88.38-107.61,90ZM247.34,149.96c0,5.13-.11,10.13-.34,14.99l-157.04.02v-29.99l157.05-.02c.22,4.84.33,9.83.33,15Z'/></svg>\"",
            "displayFolder": "Icons",
            "lineageTag": "fec363b9-eb0b-4bd7-87e8-65a687e20a61",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Title Month vs PY",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR months =",
              "    FILTER (",
              "        ADDCOLUMNS ( VALUES ( DIM_DATE[MONTH] ), \"@cy\", [Sales Count], \"@py\", [Sales Count PY] ),",
              "        NOT ISBLANK ( [@cy] )",
              "    )",
              "VAR ahead = COUNTROWS ( FILTER ( months, [@cy] > [@py] ) )",
              "VAR monthCount = COUNTROWS ( months )",
              "VAR busiest = TOPN ( 1, VALUES ( DIM_DATE[MONTH] ), [Sales Count], DESC )",
              "VAR busiestName = FORMAT ( DATE ( 2000, MAXX ( busiest, DIM_DATE[MONTH] ), 1 ), \"MMMM\" )",
              "VAR verb = SWITCH ( tense, \"past\", \" ran ahead of \", \"current\", \" is running ahead of \", \"\" )",
              "RETURN",
              "    IF ( isOneYear,",
              "         yr & verb & ( yr - 1 ) & \" in \" & ahead & \" of \" & monthCount & \" months\",",
              "         \"Since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) & \", \" & busiestName & \" has been the busiest month for sales\" )"
            ],
            "displayFolder": "Titles",
            "lineageTag": "a56100be-91cd-4a51-a3e9-079fc054805b"
          },
          {
            "name": "Title Room Type",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR known = CALCULATETABLE ( VALUES ( FCT_TRANSACTIONS[ROOM_CATEGORY] ), FCT_TRANSACTIONS[ROOM_CATEGORY] <> \"Unknown\" )",
              "VAR topRoom = TOPN ( 1, known, [Sales Count], DESC )",
              "VAR nm = MAXX ( topRoom, FCT_TRANSACTIONS[ROOM_CATEGORY] )",
              "VAR shareOfSales =",
              "    DIVIDE (",
              "        CALCULATE ( [Sales Count], topRoom ),",
              "        CALCULATE ( [Sales Count], FCT_TRANSACTIONS[ROOM_CATEGORY] <> \"Unknown\" )",
              "    )",
              "VAR verb = SWITCH ( tense, \"past\", \" homes made up \", \"current\", \" homes make up \", \" homes have made up \" )",
              "RETURN",
              "    nm & verb & FORMAT ( shareOfSales, \"0%\" ) & \" of sales \" & periodPhrase"
            ],
            "displayFolder": "Titles",
            "lineageTag": "d07a6c69-d9fe-4ca5-b5c6-d7feed4186b3"
          },
          {
            "name": "Title Top Areas",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR allAreaSales = CALCULATE ( [Sales Count], REMOVEFILTERS ( DIM_AREA ) )",
              "VAR topArea =",
              "    TOPN ( 1, CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), REMOVEFILTERS ( DIM_AREA ) ), [Sales Count], DESC )",
              "VAR nm = MAXX ( topArea, DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR shareOfSales = DIVIDE ( CALCULATE ( [Sales Count], topArea ), allAreaSales )",
              "VAR verb = SWITCH ( tense, \"past\", \" led\", \"current\", \" leads\", \" has led\" )",
              "RETURN",
              "    nm & verb & \" sales \" & periodPhrase & \", with \" & FORMAT ( shareOfSales, \"0%\" ) & \" of all transactions\""
            ],
            "displayFolder": "Titles",
            "lineageTag": "928e32db-1df6-4b7a-be07-9498ee8bfbc5"
          },
          {
            "name": "Title Property Type",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR totalValue = [Sales Value AED]",
              "VAR totalCount = [Sales Count]",
              "VAR types =",
              "    ADDCOLUMNS (",
              "        VALUES ( FCT_TRANSACTIONS[PROPERTY_TYPE_EN] ),",
              "        \"@valueShare\", DIVIDE ( [Sales Value AED], totalValue ),",
              "        \"@countShare\", DIVIDE ( [Sales Count], totalCount )",
              "    )",
              "VAR topGap = TOPN ( 1, types, [@valueShare] - [@countShare], DESC )",
              "VAR nm = MAXX ( topGap, FCT_TRANSACTIONS[PROPERTY_TYPE_EN] )",
              "VAR vs = MAXX ( topGap, [@valueShare] )",
              "VAR cs = MAXX ( topGap, [@countShare] )",
              "VAR verb = SWITCH ( tense, \"past\", \" was \", \"current\", \" is \", \" has been \" )",
              "RETURN",
              "    nm & verb & FORMAT ( cs, \"0%\" ) & \" of sales but \" & FORMAT ( vs, \"0%\" ) & \" of value \" & periodPhrase"
            ],
            "displayFolder": "Titles",
            "lineageTag": "cdaccc3f-9810-47a2-acb6-c996a1fe856d"
          },
          {
            "name": "Last Data Date",
            "expression": "CALCULATE ( MAX ( FCT_TRANSACTIONS[TRANSACTION_DATE] ), REMOVEFILTERS () )",
            "formatString": "dd mmm yyyy",
            "displayFolder": "Sales",
            "lineageTag": "534dc383-d230-4dcc-b5d9-a3ea442ae903"
          },
          {
            "name": "Sales Count PY",
            "expression": "IF ( HASONEVALUE ( DIM_DATE[YEAR] ), VAR maxDataDate = [Last Data Date] VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate ) RETURN CALCULATE ( [Sales Count], SAMEPERIODLASTYEAR ( periodDates ) ) )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "abdc4a7e-c06a-4645-87eb-a6e55e0687e4"
          },
          {
            "name": "Sales Count YoY %",
            "expression": "VAR latestYear = YEAR ( [Last Data Date] ) VAR yearToUse = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYear ) RETURN CALCULATE (     VAR maxDataDate = [Last Data Date]     VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate )     VAR cy = [Sales Count]     VAR py = CALCULATE ( [Sales Count], SAMEPERIODLASTYEAR ( periodDates ) )     RETURN DIVIDE ( cy - py, py ),     DIM_DATE[YEAR] = yearToUse )",
            "formatString": "0.0%",
            "displayFolder": "Sales",
            "lineageTag": "b39a2f86-bba5-405e-83d9-cc85b8a87301"
          },
          {
            "name": "Median Price per sqft PY",
            "expression": "VAR maxDataDate = [Last Data Date] VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate ) RETURN CALCULATE ( [Median Price per sqft], SAMEPERIODLASTYEAR ( periodDates ) )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "6beddad1-1bd4-4627-8c51-bded913b70e4"
          },
          {
            "name": "Price YoY %",
            "expression": "VAR latestYear = YEAR ( [Last Data Date] ) VAR yearToUse = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYear ) RETURN CALCULATE (     VAR maxDataDate = [Last Data Date]     VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate )     VAR cy = [Median Price per sqft]     VAR py = CALCULATE ( [Median Price per sqft], SAMEPERIODLASTYEAR ( periodDates ) )     RETURN IF ( [Residential Sales (valid)] >= 30, DIVIDE ( cy - py, py ) ),     DIM_DATE[YEAR] = yearToUse )",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Sales",
            "lineageTag": "16f02412-b0a0-4f6e-aebb-c419b646ecbe"
          },
          {
            "name": "Median Price per sqft 3Y Ago",
            "expression": "VAR maxDataDate = [Last Data Date] VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate ) RETURN CALCULATE ( [Median Price per sqft], DATEADD ( periodDates, -3, YEAR ) )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "a3028901-2984-43f1-b4fd-dfced558d2ff"
          },
          {
            "name": "Residential Sales (valid) 3Y Ago",
            "expression": "VAR maxDataDate = [Last Data Date] VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate ) RETURN CALCULATE ( [Residential Sales (valid)], DATEADD ( periodDates, -3, YEAR ) )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "d5769fb8-af11-4abf-b8dc-f4dd90e002fc"
          },
          {
            "name": "Price Growth 3Y %",
            "expression": [
              "VAR latestYear = YEAR ( [Last Data Date] )",
              "VAR yearToUse = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYear )",
              "RETURN",
              "    CALCULATE (",
              "        VAR maxDataDate = [Last Data Date]",
              "        VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate )",
              "        VAR cy = [Median Ready Price per sqft]",
              "        VAR base = CALCULATE ( [Median Ready Price per sqft], DATEADD ( periodDates, -3, YEAR ) )",
              "        VAR nNow = [Ready Residential Sales (valid)]",
              "        VAR nBase = CALCULATE ( [Ready Residential Sales (valid)], DATEADD ( periodDates, -3, YEAR ) )",
              "        RETURN IF ( nNow >= 50 && nBase >= 50, DIVIDE ( cy - base, base ) ),",
              "        DIM_DATE[YEAR] = yearToUse",
              "    )"
            ],
            "formatString": "+0%;-0%;0%",
            "displayFolder": "Sales",
            "lineageTag": "ba7e1f8a-f8f0-47f0-bd09-0f909bcca113"
          },
          {
            "name": "Median Price per sqft Dubai",
            "expression": "CALCULATE ( [Median Price per sqft], REMOVEFILTERS ( DIM_AREA ) )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "41d3eda4-c941-4243-a64d-24bd29875328"
          },
          {
            "name": "Active Areas",
            "expression": "COUNTROWS ( FILTER ( VALUES ( DIM_AREA[AREA_ID] ), [Sales Count] > 0 ) )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "e2f4a1d0-3710-490e-b145-f309a470022c"
          },
          {
            "name": "Title Area Scorecard",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR top10 =",
              "    TOPN ( 8, CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), REMOVEFILTERS ( DIM_AREA ) ), [Sales Count], DESC )",
              "VAR best =",
              "    TOPN ( 1, FILTER ( top10, NOT ISBLANK ( [Gross Yield (Ready)] ) ), [Gross Yield (Ready)], DESC )",
              "VAR nm = MAXX ( best, DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR bestYield = MAXX ( best, [Gross Yield (Ready)] )",
              "VAR verb = SWITCH ( tense, \"past\", \" offered\", \"current\", \" offers\", \" has offered\" )",
              "RETURN",
              "    \"Of the 8 busiest areas \" & periodPhrase & \", \" & nm & verb & \" the highest ready yield at \" & FORMAT ( bestYield, \"0.0%\" )"
            ],
            "displayFolder": "Titles",
            "lineageTag": "e500124c-52b8-4a71-8b1f-c154cde65ba5"
          },
          {
            "name": "Title Area Ranking",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR startYr = 2019",
              "VAR top8 =",
              "    CALCULATETABLE (",
              "        TOPN ( 8, VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), [Sales Count], DESC ),",
              "        REMOVEFILTERS ( DIM_AREA ), REMOVEFILTERS ( DIM_DATE ),",
              "        DIM_DATE[YEAR] >= startYr, DIM_DATE[YEAR] <= latestYr )",
              "VAR leader =",
              "    TOPN ( 1, top8, CALCULATE ( [Sales Count], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = latestYr ), DESC )",
              "VAR nm = MAXX ( leader, DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR rankStart =",
              "    RANKX ( ALL ( DIM_AREA[AREA_DISPLAY_NAME] ),",
              "            CALCULATE ( [Sales Count], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = startYr ),",
              "            CALCULATE ( [Sales Count], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = startYr, DIM_AREA[AREA_DISPLAY_NAME] = nm ),",
              "            DESC )",
              "VAR rankLatest =",
              "    RANKX ( ALL ( DIM_AREA[AREA_DISPLAY_NAME] ),",
              "            CALCULATE ( [Sales Count], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = latestYr ),",
              "            CALCULATE ( [Sales Count], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = latestYr, DIM_AREA[AREA_DISPLAY_NAME] = nm ),",
              "            DESC )",
              "RETURN",
              "    IF ( rankStart = rankLatest,",
              "         nm & \" has held #\" & rankLatest & \" in sales since \" & startYr,",
              "         nm & \" climbed from #\" & rankStart & \" in \" & startYr & \" to #\" & rankLatest & \" in \" & latestYr )"
            ],
            "displayFolder": "Titles",
            "lineageTag": "2e87547f-d803-4af7-aa33-8e6b347b9e31"
          },
          {
            "name": "Area Sales Rank",
            "expression": "IF ( ISINSCOPE ( DIM_AREA[AREA_DISPLAY_NAME] ) && [Sales Count] > 0, RANKX ( ALL ( DIM_AREA[AREA_DISPLAY_NAME] ), [Sales Count], , DESC ) )",
            "formatString": "#0",
            "displayFolder": "Sales",
            "lineageTag": "1fed391e-9127-4905-9d4d-285700248f63"
          },
          {
            "name": "Title Price Trend",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yearToUse = IF ( isOneYear, SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr )",
              "VAR isPast = yearToUse < latestYr",
              "VAR isOneArea = HASONEVALUE ( DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR nm = SELECTEDVALUE ( DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR areaPrice = CALCULATE ( [Median Price per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse )",
              "VAR dubaiPrice = CALCULATE ( [Median Price per sqft Dubai], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse )",
              "VAR dubaiBase = CALCULATE ( [Median Price per sqft Dubai], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse - 5 )",
              "VAR gap = DIVIDE ( areaPrice, dubaiPrice ) - 1",
              "RETURN",
              "    IF ( isOneArea,",
              "         nm & IF ( isPast, \" was \", \" is \" ) & FORMAT ( ABS ( gap ), \"0%\" )",
              "            & IF ( gap >= 0, \" above\", \" below\" ) & \" the Dubai median in \" & yearToUse,",
              "         \"Dubai's price per sq ft\" & IF ( isPast, \" rose \", \" has risen \" )",
              "            & FORMAT ( DIVIDE ( dubaiPrice, dubaiBase ) - 1, \"0%\" ) & \" in 5 years to \" & yearToUse )"
            ],
            "displayFolder": "Titles",
            "lineageTag": "004beb23-7879-4635-83ea-4e0032b67b93"
          },
          {
            "name": "Title Price Growth",
            "expression": [
              "VAR latestYear = YEAR ( [Last Data Date] )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yearToUse = IF ( isOneYear, SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYear )",
              "VAR areas =",
              "    FILTER (",
              "        CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), REMOVEFILTERS ( DIM_AREA ) ),",
              "        NOT ISBLANK ( [Price Growth 3Y %] )",
              "    )",
              "VAR leader = TOPN ( 1, areas, [Price Growth 3Y %], DESC )",
              "VAR nm = MAXX ( leader, DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR g = MAXX ( leader, [Price Growth 3Y %] )",
              "RETURN",
              "    nm & \": ready-home prices up \" & FORMAT ( g, \"0%\" ) & \" in 3 years to \" & yearToUse"
            ],
            "displayFolder": "Titles",
            "lineageTag": "3b2f07de-26df-476c-a981-5549aa348fc4"
          },
          {
            "name": "Trend Price Area",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Price per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "c02a95d8-369c-4352-852c-71dd489f08da"
          },
          {
            "name": "Trend Price Dubai",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Price per sqft Dubai], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "9b517cf6-8581-4c0e-a6ed-a0dc38cdc791"
          },
          {
            "name": "Trend Price Selected Year",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && axisYear = SELECTEDVALUE ( DIM_DATE[YEAR] ), [Trend Price Area] )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "20d0a817-5b09-4ce7-bcb6-518404eea49c"
          },
          {
            "name": "Median Off-Plan Price per sqft",
            "expression": "CALCULATE ( [Median Price per sqft], FCT_TRANSACTIONS[IS_OFF_PLAN] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "045ccb71-6bd7-4b14-bffa-d3e0813eb7de"
          },
          {
            "name": "Off-Plan Premium %",
            "expression": "VAR offPlan = [Median Off-Plan Price per sqft] VAR ready = [Median Ready Price per sqft] VAR nOff = CALCULATE ( [Residential Sales (valid)], FCT_TRANSACTIONS[IS_OFF_PLAN] = TRUE () ) VAR nReady = [Ready Residential Sales (valid)] RETURN IF ( nOff >= 30 && nReady >= 30, DIVIDE ( offPlan - ready, ready ) )",
            "formatString": "+0%;-0%;0%",
            "displayFolder": "Sales",
            "lineageTag": "33e9a69a-daff-4929-9e90-a471d3add49e"
          },
          {
            "name": "Median Unit Price per sqft",
            "expression": "DIVIDE ( CALCULATE ( MEDIAN ( FCT_TRANSACTIONS[PRICE_PER_SQM_AED] ), FCT_TRANSACTIONS[IS_SALE] = TRUE (), FCT_TRANSACTIONS[IS_PRICE_VALID] = TRUE (), FCT_TRANSACTIONS[PROPERTY_TYPE_EN] = \"Unit\" ), 10.7639 )",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "3e2b58c2-5fe6-4aaf-81e7-ecfa1c0f5ebf"
          },
          {
            "name": "Median Unit Valuation per sqft",
            "expression": "DIVIDE ( CALCULATE ( MEDIAN ( FCT_VALUATIONS[VALUE_PER_SQM_AED] ), FCT_VALUATIONS[IS_VALUE_VALID] = TRUE (), FCT_VALUATIONS[PROPERTY_TYPE_EN] = \"Unit\" ), 10.7639 )",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "5503914b-8bb6-4090-a1d5-8ef63d9b9da1"
          },
          {
            "name": "Unit Valuations",
            "expression": "CALCULATE ( COUNTROWS ( FCT_VALUATIONS ), FCT_VALUATIONS[IS_VALUE_VALID] = TRUE (), FCT_VALUATIONS[PROPERTY_TYPE_EN] = \"Unit\" )",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "f4a6426c-3403-4a7c-8274-ad2acde2ba44"
          },
          {
            "name": "Unit Sales (valid)",
            "expression": "CALCULATE ( COUNTROWS ( FCT_TRANSACTIONS ), FCT_TRANSACTIONS[IS_SALE] = TRUE (), FCT_TRANSACTIONS[IS_PRICE_VALID] = TRUE (), FCT_TRANSACTIONS[PROPERTY_TYPE_EN] = \"Unit\" )",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "de8c488b-ac4e-4008-a708-ff6d707a764b"
          },
          {
            "name": "Sale vs Valuation %",
            "expression": "IF ( [Unit Sales (valid)] >= 30 && [Unit Valuations] >= 30, DIVIDE ( [Median Unit Price per sqft] - [Median Unit Valuation per sqft], [Median Unit Valuation per sqft] ) )",
            "formatString": "+0%;-0%;0%",
            "displayFolder": "Valuations",
            "lineageTag": "0dcb04a0-7133-4ac9-a727-b00734a1d887"
          },
          {
            "name": "Title Price Bands",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase = IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR bands =",
              "    FILTER (",
              "        ADDCOLUMNS ( VALUES ( FCT_TRANSACTIONS[PRICE_BAND] ), \"@n\", [Residential Sales (valid)] ),",
              "        NOT ISBLANK ( FCT_TRANSACTIONS[PRICE_BAND] ) && [@n] > 0 )",
              "VAR topBand = TOPN ( 1, bands, [@n], DESC )",
              "VAR nm = MAXX ( topBand, FCT_TRANSACTIONS[PRICE_BAND] )",
              "VAR shareOfSales = DIVIDE ( MAXX ( topBand, [@n] ), [Residential Sales (valid)] )",
              "VAR verb = SWITCH ( tense, \"past\", \" was \", \"current\", \" is \", \" has been \" )",
              "RETURN",
              "    \"The most common home price \" & periodPhrase & verb & nm & \" AED, with \" & FORMAT ( shareOfSales, \"0%\" ) & \" of home sales\""
            ],
            "displayFolder": "Titles",
            "lineageTag": "1bd39038-335e-43f6-93a4-6e8de9177631"
          },
          {
            "name": "Trend Ready Price",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Ready Price per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "de5b1d48-4140-4803-8003-4a2027774f1c"
          },
          {
            "name": "Trend Off-Plan Price",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Off-Plan Price per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "cb160968-6eb6-417d-b609-97e7d1795def"
          },
          {
            "name": "Trend Off-Plan Selected Year",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && axisYear = SELECTEDVALUE ( DIM_DATE[YEAR] ), [Trend Off-Plan Price] )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "ea8e523e-e163-458d-b42f-214009d9dff8"
          },
          {
            "name": "Title Off-Plan Premium",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yearToUse = IF ( isOneYear, SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr )",
              "VAR isPast = yearToUse < latestYr",
              "VAR premium = CALCULATE ( [Off-Plan Premium %], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse )",
              "RETURN",
              "    \"Off-plan\" & IF ( isPast, \" sold at a \", \" sell at a \" )",
              "        & FORMAT ( ABS ( premium ), \"0%\" ) & IF ( premium >= 0, \" premium\", \" discount\" )",
              "        & \" per sq ft in \" & yearToUse"
            ],
            "displayFolder": "Titles",
            "lineageTag": "8d78f096-8195-4975-9b45-331e2d0024ba"
          },
          {
            "name": "Title Room Price Growth",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yearToUse = IF ( isOneYear, SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr )",
              "VAR isPast = yearToUse < latestYr",
              "VAR rooms =",
              "    ADDCOLUMNS (",
              "        FILTER ( VALUES ( FCT_TRANSACTIONS[ROOM_CATEGORY] ),",
              "                 FCT_TRANSACTIONS[ROOM_CATEGORY] IN { \"Studio\", \"1 BR\", \"2 BR\", \"3 BR\" } ),",
              "        \"@now\",  CALCULATE ( [Median Price per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse ),",
              "        \"@base\", CALCULATE ( [Median Price per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse - 5 )",
              "    )",
              "VAR ranked = ADDCOLUMNS ( rooms, \"@growth\", DIVIDE ( [@now] - [@base], [@base] ) )",
              "VAR best = TOPN ( 1, ranked, [@growth], DESC )",
              "VAR nm = MAXX ( best, FCT_TRANSACTIONS[ROOM_CATEGORY] )",
              "VAR g = MAXX ( best, [@growth] )",
              "RETURN",
              "    nm & \" prices\" & IF ( isPast, \" rose \", \" have risen \" ) & FORMAT ( g, \"0%\" )",
              "        & \" in 5 years to \" & yearToUse & \", fastest of any size\""
            ],
            "displayFolder": "Titles",
            "lineageTag": "8e54fb79-f716-4f13-a7cb-1414d00d3d43"
          },
          {
            "name": "Slope Price",
            "expression": "VAR latestYr = YEAR ( [Last Data Date] ) VAR yearToUse = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr ) VAR pointNo = SELECTEDVALUE ( SLOPE_POINT[POINT_ORDER] ) VAR targetYear = IF ( pointNo = 1, yearToUse - 5, yearToUse ) RETURN CALCULATE ( [Median Price per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = targetYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "30de3cf6-cf69-42a6-ab0c-2f446dfcb075"
          },
          {
            "name": "Slope Index",
            "expression": "VAR startPrice = CALCULATE ( [Slope Price], REMOVEFILTERS ( SLOPE_POINT ), SLOPE_POINT[POINT_ORDER] = 1 ) RETURN DIVIDE ( [Slope Price], startPrice ) * 100",
            "formatString": "0",
            "displayFolder": "Trend",
            "lineageTag": "9ac18ac2-e859-413e-8339-bee7898f7211"
          },
          {
            "name": "Title Sale vs Valuation",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase = IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR comparable =",
              "    FILTER (",
              "        ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), REMOVEFILTERS ( DIM_AREA ) ),",
              "                     \"@gap\", [Sale vs Valuation %], \"@vals\", [Unit Valuations] ),",
              "        NOT ISBLANK ( [@gap] ) )",
              "VAR top10 = TOPN ( 15, comparable, [@vals], DESC )",
              "VAR above = COUNTROWS ( FILTER ( top10, [@gap] > 0 ) )",
              "VAR total = COUNTROWS ( top10 )",
              "VAR verb = SWITCH ( tense, \"past\", \" sold \", \"current\", \" sell \", \" have sold \" )",
              "RETURN",
              "    \"Apartments\" & verb & \"above official valuation in \" & above & \" of \" & total & \" comparable areas \" & periodPhrase"
            ],
            "displayFolder": "Titles",
            "lineageTag": "1f6cca39-4845-4e07-be04-f607a3566334"
          },
          {
            "name": "Dumbbell Upper",
            "expression": "IF ( NOT ISBLANK ( [Sale vs Valuation %] ), MAX ( [Median Unit Price per sqft], [Median Unit Valuation per sqft] ) )",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "7861e31f-0d37-4918-9158-efcdaad74b84"
          },
          {
            "name": "Dumbbell Lower",
            "expression": "IF ( NOT ISBLANK ( [Sale vs Valuation %] ), MIN ( [Median Unit Price per sqft], [Median Unit Valuation per sqft] ) )",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "ebd8eab9-3b98-4a95-a8d6-1ba77b9f00ef"
          },
          {
            "name": "Dumbbell Axis Min",
            "expression": "VAR lo = MINX ( ALLSELECTED ( DIM_AREA[AREA_DISPLAY_NAME] ), [Dumbbell Lower] ) VAR hi = MAXX ( ALLSELECTED ( DIM_AREA[AREA_DISPLAY_NAME] ), [Dumbbell Upper] ) RETURN lo - ( hi - lo ) * 0.08",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "a0318599-516d-4811-9519-e94fc1735f98"
          },
          {
            "name": "Dumbbell Axis Max",
            "expression": "VAR lo = MINX ( ALLSELECTED ( DIM_AREA[AREA_DISPLAY_NAME] ), [Dumbbell Lower] ) VAR hi = MAXX ( ALLSELECTED ( DIM_AREA[AREA_DISPLAY_NAME] ), [Dumbbell Upper] ) RETURN hi + ( hi - lo ) * 0.06",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "8054bd13-171d-41a8-92ef-bca221640581"
          },
          {
            "name": "Median Renewal Rent per sqft",
            "expression": "DIVIDE ( CALCULATE ( MEDIAN ( FCT_RENT_CONTRACTS[RENT_PER_SQM_AED] ), FCT_RENT_CONTRACTS[IS_NEW_CONTRACT] = FALSE (), FCT_RENT_CONTRACTS[IS_RENT_VALID] = TRUE (), FCT_RENT_CONTRACTS[IS_RESIDENTIAL] = TRUE (), FCT_RENT_CONTRACTS[IS_SINGLE_PROPERTY] = TRUE () ), 10.7639 )",
            "formatString": "#,0.0",
            "displayFolder": "Rents",
            "lineageTag": "1d95f05b-890a-49be-a243-2fd3e6e8fd56"
          },
          {
            "name": "Rent YoY %",
            "expression": "VAR latestYear = YEAR ( [Last Data Date] ) VAR yearToUse = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYear ) RETURN CALCULATE (   VAR maxDataDate = [Last Data Date]   VAR periodDates = FILTER ( VALUES ( DIM_DATE[DATE_DAY] ), DIM_DATE[DATE_DAY] <= maxDataDate )   VAR cy = [Median Rent per sqft]   VAR py = CALCULATE ( [Median Rent per sqft], SAMEPERIODLASTYEAR ( periodDates ) )   RETURN IF ( [Market Rent Contracts] >= 30, DIVIDE ( cy - py, py ) ),   DIM_DATE[YEAR] = yearToUse )",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Rents",
            "lineageTag": "bdecbe5b-a567-4bbe-bb91-c0d4f9798df9"
          },
          {
            "name": "Dubai Ready Price per sqft",
            "expression": "CALCULATE ( [Median Ready Price per sqft], REMOVEFILTERS ( DIM_AREA ) )",
            "formatString": "#,0",
            "displayFolder": "Yield",
            "lineageTag": "7a6bf020-cef5-4fe9-8e11-c2611729ea34"
          },
          {
            "name": "Dubai Rent per sqft",
            "expression": "CALCULATE ( [Median Rent per sqft], REMOVEFILTERS ( DIM_AREA ) )",
            "formatString": "#,0.0",
            "displayFolder": "Yield",
            "lineageTag": "cd7d1eac-1fe3-4607-9bba-702991af0e71"
          },
          {
            "name": "Trend Rent New",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Rent per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0.0",
            "displayFolder": "Trend",
            "lineageTag": "bcff6537-db50-41ee-b247-c70e092f94a7"
          },
          {
            "name": "Trend Rent Renewal",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Renewal Rent per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0.0",
            "displayFolder": "Trend",
            "lineageTag": "0171a823-9d43-4957-b867-06307b4e1f29"
          },
          {
            "name": "Trend Rent Area",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Rent per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0.0",
            "displayFolder": "Trend",
            "lineageTag": "3d04eeca-a40c-4315-93a9-32eaebc285d0"
          },
          {
            "name": "Waterfall Yield",
            "expression": "VAR stepNo = SELECTEDVALUE ( WATERFALL_STEP[STEP_ORDER] ) RETURN SWITCH ( stepNo, 1, [Gross Yield], 2, [Gross Yield (Ready)] - [Gross Yield], 3, [Net Yield (Ready)] - [Gross Yield (Ready)] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Yield",
            "lineageTag": "0dad2915-3d30-4fa4-8617-1578ccb17ae0"
          },
          {
            "name": "Title Yield Quadrant",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase = IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR dubaiPrice = [Dubai Ready Price per sqft]",
              "VAR dubaiRent = [Dubai Rent per sqft]",
              "VAR areas =",
              "    FILTER (",
              "        ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), REMOVEFILTERS ( DIM_AREA ) ),",
              "                     \"@price\", [Median Ready Price per sqft], \"@rent\", [Median Rent per sqft], \"@yield\", [Gross Yield (Ready)] ),",
              "        NOT ISBLANK ( [@yield] ) )",
              "VAR top30 = TOPN ( 30, areas, CALCULATE ( [Market Rent Contracts] ), DESC ) VAR sweet = FILTER ( top30, [@price] < dubaiPrice && [@rent] > dubaiRent )",
              "VAR n = COUNTROWS ( sweet )",
              "VAR best = MAXX ( TOPN ( 1, sweet, [@yield], DESC ), DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR verb = SWITCH ( tense, \"past\", \" beat\", \"current\", \" beat\", \" have beaten\" )",
              "RETURN",
              "    IF ( n > 0,",
              "         n & \" areas\" & verb & \" Dubai on price and rent \" & periodPhrase & \", led by \" & best,",
              "         \"No area beat Dubai on both price and rent \" & periodPhrase )"
            ],
            "displayFolder": "Titles",
            "lineageTag": "194e65e2-ceda-441e-b85b-98743e150a51"
          },
          {
            "name": "Title Yield Waterfall",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase = IF ( isOneYear, \"in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR verb = SWITCH ( tense, \"past\", \" yielded \", \"current\", \" yield \", \" have yielded \" )",
              "RETURN",
              "    \"Ready homes\" & verb & FORMAT ( [Gross Yield (Ready)], \"0.0%\" ) & \" gross and \"",
              "        & FORMAT ( [Net Yield (Ready)], \"0.0%\" ) & \" net \" & periodPhrase"
            ],
            "displayFolder": "Titles",
            "lineageTag": "d3d6a897-d1c6-4f69-9e63-229fab0a0489"
          },
          {
            "name": "Trend Rent Selected Year",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && axisYear = SELECTEDVALUE ( DIM_DATE[YEAR] ), [Trend Rent New] )",
            "formatString": "#,0.0",
            "displayFolder": "Trend",
            "lineageTag": "b9c0b61c-f314-4bd3-8e27-35d1d860207d"
          },
          {
            "name": "Title Renewal Gap",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yearToUse = IF ( isOneYear, SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr )",
              "VAR isPast = yearToUse < latestYr",
              "VAR newRent = CALCULATE ( [Median Rent per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse )",
              "VAR renewRent = CALCULATE ( [Median Renewal Rent per sqft], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse )",
              "VAR gap = DIVIDE ( renewRent, newRent ) - 1",
              "RETURN",
              "    \"Renewing tenants\" & IF ( isPast, \" paid \", \" pay \" ) & FORMAT ( ABS ( gap ), \"0%\" )",
              "        & IF ( gap <= 0, \" less\", \" more\" ) & \" per sq ft than new tenants in \" & yearToUse"
            ],
            "displayFolder": "Titles",
            "lineageTag": "9ad8cceb-bcdc-44f1-bedd-1ed70c360e66"
          },
          {
            "name": "Title Rent Growth",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yearToUse = IF ( isOneYear, SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr )",
              "VAR isPast = yearToUse < latestYr",
              "VAR top8 =",
              "    TOPN ( 6, CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), REMOVEFILTERS ( DIM_AREA ) ), [Market Rent Contracts], DESC )",
              "VAR withGrowth = FILTER ( ADDCOLUMNS ( top8, \"@g\", [Rent YoY %] ), NOT ISBLANK ( [@g] ) )",
              "VAR best = TOPN ( 1, withGrowth, [@g], DESC )",
              "VAR nm = MAXX ( best, DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR g = MAXX ( best, [@g] )",
              "RETURN",
              "    nm & IF ( isPast, \" led \", \" leads \" ) & \"rent growth: \" & FORMAT ( g, \"+0%;-0%\" ) & \" in \" & yearToUse"
            ],
            "displayFolder": "Titles",
            "lineageTag": "cd56a607-fad4-4d41-bf66-3228cfd1d2a7"
          },
          {
            "name": "Active Projects",
            "expression": "CALCULATE ( COUNTROWS ( DIM_PROJECT ), DIM_PROJECT[PROJECT_STATUS] = \"ACTIVE\" )",
            "formatString": "#,0",
            "displayFolder": "Projects",
            "lineageTag": "6dee1380-7b35-4a9a-b6c2-8aba1446d3f1"
          },
          {
            "name": "Pipeline Units",
            "expression": "CALCULATE ( SUM ( DIM_PROJECT[NO_OF_UNITS] ), DIM_PROJECT[PROJECT_STATUS] IN { \"ACTIVE\", \"NOT_STARTED\", \"PENDING\", \"CONDITIONAL_ACTIVATING\" } )",
            "formatString": "#,0",
            "displayFolder": "Projects",
            "lineageTag": "e2e22856-dd1e-44c3-94d6-2335c6aaafd3"
          },
          {
            "name": "Active Completion % (Unit-Weighted)",
            "expression": "VAR act = FILTER ( DIM_PROJECT, DIM_PROJECT[PROJECT_STATUS] = \"ACTIVE\" && DIM_PROJECT[NO_OF_UNITS] > 0 && NOT ISBLANK ( DIM_PROJECT[PERCENT_COMPLETED] ) ) RETURN DIVIDE ( SUMX ( act, DIM_PROJECT[PERCENT_COMPLETED] * DIM_PROJECT[NO_OF_UNITS] ), SUMX ( act, DIM_PROJECT[NO_OF_UNITS] ) ) / 100",
            "formatString": "0%",
            "displayFolder": "Projects",
            "lineageTag": "400f9f1e-2a9f-4762-9410-2afc7017c88e"
          },
          {
            "name": "Overdue Active Projects",
            "expression": "VAR asOf = [Last Data Date] RETURN CALCULATE ( COUNTROWS ( DIM_PROJECT ), DIM_PROJECT[PROJECT_STATUS] = \"ACTIVE\", NOT ISBLANK ( DIM_PROJECT[PROJECT_END_DATE] ), DIM_PROJECT[PROJECT_END_DATE] < asOf )",
            "formatString": "#,0",
            "displayFolder": "Projects",
            "lineageTag": "67ef4fd9-26e8-486e-aa38-eede3af096e3"
          },
          {
            "name": "Finished Projects",
            "expression": "CALCULATE ( COUNTROWS ( DIM_PROJECT ), DIM_PROJECT[PROJECT_STATUS] = \"FINISHED\" )",
            "formatString": "#,0",
            "displayFolder": "Projects",
            "lineageTag": "bc64b161-a2c4-4b71-be57-d7c83d3b0be0"
          },
          {
            "name": "Delivered by End Date %",
            "expression": "VAR fin = FILTER ( DIM_PROJECT, DIM_PROJECT[PROJECT_STATUS] = \"FINISHED\" && NOT ISBLANK ( DIM_PROJECT[COMPLETION_DATE] ) && NOT ISBLANK ( DIM_PROJECT[PROJECT_END_DATE] ) ) RETURN IF ( COUNTROWS ( fin ) >= 3, DIVIDE ( COUNTROWS ( FILTER ( fin, DIM_PROJECT[COMPLETION_DATE] <= DIM_PROJECT[PROJECT_END_DATE] ) ), COUNTROWS ( fin ) ) )",
            "formatString": "0%",
            "displayFolder": "Projects",
            "lineageTag": "84c8ebb9-11f3-4289-95c4-51df617ed113"
          },
          {
            "name": "Avg Delay Months (Late Projects)",
            "expression": "VAR late = FILTER ( DIM_PROJECT, DIM_PROJECT[PROJECT_STATUS] = \"FINISHED\" && NOT ISBLANK ( DIM_PROJECT[COMPLETION_DATE] ) && NOT ISBLANK ( DIM_PROJECT[PROJECT_END_DATE] ) && DIM_PROJECT[COMPLETION_DATE] > DIM_PROJECT[PROJECT_END_DATE] ) RETURN AVERAGEX ( late, DATEDIFF ( DIM_PROJECT[PROJECT_END_DATE], DIM_PROJECT[COMPLETION_DATE], MONTH ) )",
            "formatString": "0.0",
            "displayFolder": "Projects",
            "lineageTag": "fff7d2ee-5b26-4d4f-862d-bfeb5846a8bd"
          },
          {
            "name": "Developers with Active Projects",
            "expression": "CALCULATE ( DISTINCTCOUNT ( DIM_PROJECT[DEVELOPER_ID] ), DIM_PROJECT[PROJECT_STATUS] = \"ACTIVE\" )",
            "formatString": "#,0",
            "displayFolder": "Projects",
            "lineageTag": "ecf29775-b1b7-4324-b348-b7c808578c31"
          },
          {
            "name": "Title Developer Heatmap",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR devSales =",
              "    CALCULATETABLE (",
              "        ADDCOLUMNS ( FILTER ( VALUES ( DIM_PROJECT[DEVELOPER_NAME] ), NOT ISBLANK ( DIM_PROJECT[DEVELOPER_NAME] ) ),",
              "                     \"@s\", [Sales Count] ),",
              "        REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_PROJECT ), DIM_DATE[YEAR] >= 2019, DIM_DATE[YEAR] <= latestYr )",
              "VAR totalSales = SUMX ( devSales, [@s] )",
              "VAR top10Sales = SUMX ( TOPN ( 10, devSales, [@s], DESC ), [@s] )",
              "RETURN",
              "    \"The top 10 developers have made \" & FORMAT ( DIVIDE ( top10Sales, totalSales ), \"0%\" )",
              "        & \" of project-linked sales since 2019\""
            ],
            "displayFolder": "Titles",
            "lineageTag": "d4f8427e-68c3-473a-aaf0-17104d92912d"
          },
          {
            "name": "Title Supply Pipeline",
            "expression": [
              "VAR buckets =",
              "    ADDCOLUMNS (",
              "        FILTER ( VALUES ( DIM_PROJECT[DELIVERY_BUCKET] ),",
              "                 NOT DIM_PROJECT[DELIVERY_BUCKET] IN { \"Overdue\", \"No date\" } ),",
              "        \"@u\", [Pipeline Units] )",
              "VAR peak = TOPN ( 1, buckets, [@u], DESC )",
              "VAR peakYear = MAXX ( peak, DIM_PROJECT[DELIVERY_BUCKET] )",
              "VAR peakUnits = MAXX ( peak, [@u] )",
              "VAR overdueUnits = CALCULATE ( [Pipeline Units], DIM_PROJECT[DELIVERY_BUCKET] = \"Overdue\" )",
              "RETURN",
              "    \"Supply peaks in \" & peakYear & \" with \" & FORMAT ( peakUnits, \"#,0\" ) & \" units due, plus \"",
              "        & FORMAT ( overdueUnits, \"#,0\" ) & \" overdue\""
            ],
            "displayFolder": "Titles",
            "lineageTag": "1efd1fb1-b1f7-452f-9fc9-d153c852600a"
          },
          {
            "name": "Title Developer Track Record",
            "expression": [
              "VAR devs =",
              "    ADDCOLUMNS (",
              "        FILTER ( CALCULATETABLE ( VALUES ( DIM_PROJECT[DEVELOPER_NAME] ), REMOVEFILTERS ( DIM_PROJECT ) ),",
              "                 NOT ISBLANK ( DIM_PROJECT[DEVELOPER_NAME] ) ),",
              "        \"@units\", [Pipeline Units], \"@overdue\", [Overdue Active Projects] )",
              "VAR top8 = TOPN ( 8, devs, [@units], DESC )",
              "VAR worst = TOPN ( 1, top8, [@overdue], DESC )",
              "VAR nm = MAXX ( worst, DIM_PROJECT[DEVELOPER_NAME] )",
              "VAR n = MAXX ( worst, [@overdue] )",
              "RETURN",
              "    \"Among the 8 biggest pipelines, \" & nm & \" has the most projects past their end date (\" & n & \")\""
            ],
            "displayFolder": "Titles",
            "lineageTag": "48420d38-e9f5-439d-950c-f41b39f1e02f"
          },
          {
            "name": "Active Units Still to Build",
            "expression": "SUMX ( FILTER ( DIM_PROJECT, DIM_PROJECT[PROJECT_STATUS] = \"ACTIVE\" && DIM_PROJECT[NO_OF_UNITS] > 0 && NOT ISBLANK ( DIM_PROJECT[PERCENT_COMPLETED] ) ), DIM_PROJECT[NO_OF_UNITS] * ( 1 - DIM_PROJECT[PERCENT_COMPLETED] / 100 ) )",
            "formatString": "#,0",
            "displayFolder": "Projects",
            "lineageTag": "d5e05e11-7d10-458b-bade-e62460cf5556"
          },
          {
            "name": "Title Pipeline Gauge",
            "expression": "\"The active pipeline is \" & FORMAT ( [Active Completion % (Unit-Weighted)], \"0%\" ) & \" built, with \" & FORMAT ( [Active Units Still to Build], \"#,0\" ) & \" homes' worth still to go\"",
            "displayFolder": "Titles",
            "lineageTag": "990bc6fd-67c9-46e6-af60-b303dd3a3c54"
          },
          {
            "name": "Existing Units in Project Areas",
            "expression": "CALCULATE ( [Registered Units], TREATAS ( VALUES ( DIM_PROJECT[AREA_ID] ), DIM_AREA[AREA_ID] ) )",
            "formatString": "#,0",
            "displayFolder": "Projects",
            "lineageTag": "370281e6-bf9d-4e7e-847c-d002aee8f45c"
          },
          {
            "name": "Supply Pressure %",
            "expression": "DIVIDE ( [Pipeline Units], [Existing Units in Project Areas] )",
            "formatString": "0%",
            "displayFolder": "Projects",
            "lineageTag": "1c89ee4f-850e-45ca-8cbc-3824e4b047f1"
          },
          {
            "name": "Title Supply Pressure",
            "expression": "VAR areas = ADDCOLUMNS ( FILTER ( VALUES ( DIM_PROJECT[AREA_DISPLAY_NAME] ), NOT ISBLANK ( DIM_PROJECT[AREA_DISPLAY_NAME] ) ), \"@units\", [Pipeline Units] ) VAR biggest = TOPN ( 1, areas, [@units], DESC ) RETURN MAXX ( biggest, DIM_PROJECT[AREA_DISPLAY_NAME] ) & \" leads new supply: \" & FORMAT ( MAXX ( biggest, [@units] ), \"#,0\" ) & \" homes\"",
            "displayFolder": "Titles",
            "lineageTag": "5c2cbc17-6882-462f-91cf-9145d376762d"
          },
          {
            "name": "Summary The Market",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr,",
              "             \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR changePhrase =",
              "    SWITCH ( tense, \"past\", \" on \" & ( yr - 1 ), \"current\", \" on the same period of \" & ( yr - 1 ), \"\" )",
              "VAR s = [Sales Count]",
              "VAR v = [Sales Value AED]",
              "VAR g = [Sales Count YoY %]",
              "RETURN",
              "    FORMAT ( s, \"#,0\" ) & \" sales worth AED \" & FORMAT ( v / 1e9, \"#,0.0\" ) & \"bn \" & periodPhrase",
              "        & IF ( tense <> \"all\" && NOT ISBLANK ( g ),",
              "               \", \" & IF ( g >= 0, \"up \", \"down \" ) & FORMAT ( ABS ( g ), \"0.0%\" ) & changePhrase )"
            ],
            "displayFolder": "Summaries",
            "lineageTag": "94ade724-cd58-4ba8-b0e4-28a9cec21299"
          },
          {
            "name": "Summary Where to Buy",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr,",
              "             \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR changePhrase =",
              "    SWITCH ( tense, \"past\", \" on \" & ( yr - 1 ), \"current\", \" on the same period of \" & ( yr - 1 ), \"\" )",
              "VAR p = [Median Price per sqft]",
              "VAR g = [Price YoY %]",
              "VAR verb = SWITCH ( tense, \"past\", \" was \", \"current\", \" is \", \" has been \" )",
              "RETURN",
              "    \"The median home price\" & verb & \"AED \" & FORMAT ( p, \"#,0\" ) & \" per sq ft \" & periodPhrase",
              "        & IF ( tense <> \"all\" && NOT ISBLANK ( g ),",
              "               \", \" & IF ( g >= 0, \"up \", \"down \" ) & FORMAT ( ABS ( g ), \"0.0%\" ) & changePhrase )",
              "        & \", across \" & [Active Areas] & \" active areas\""
            ],
            "displayFolder": "Summaries",
            "lineageTag": "fa904613-4eb2-445c-adb8-895017255544"
          },
          {
            "name": "Summary What It Costs",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr,",
              "             \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR changePhrase =",
              "    SWITCH ( tense, \"past\", \" on \" & ( yr - 1 ), \"current\", \" on the same period of \" & ( yr - 1 ), \"\" )",
              "VAR prem = [Off-Plan Premium %]",
              "VAR val = [Sale vs Valuation %]",
              "VAR verbSold = SWITCH ( tense, \"past\", \" sold \", \"current\", \" sells \", \" has sold \" )",
              "RETURN",
              "    \"Off-plan\" & verbSold & \"at a \" & FORMAT ( prem, \"0%\" ) & \" premium to ready homes \" & periodPhrase",
              "        & IF ( NOT ISBLANK ( val ),",
              "               \"; apartments\" & SWITCH ( tense, \"past\", \" sold \", \"current\", \" sell \", \" have sold \" )",
              "                   & FORMAT ( ABS ( val ), \"0%\" ) & IF ( val >= 0, \" above\", \" below\" ) & \" official valuation\" )"
            ],
            "displayFolder": "Summaries",
            "lineageTag": "920f660b-384c-42d8-93a0-3336a52301f3"
          },
          {
            "name": "Summary What It Earns",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase =",
              "    SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr,",
              "             \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR changePhrase =",
              "    SWITCH ( tense, \"past\", \" on \" & ( yr - 1 ), \"current\", \" on the same period of \" & ( yr - 1 ), \"\" )",
              "VAR verb = SWITCH ( tense, \"past\", \" yielded \", \"current\", \" yield \", \" have yielded \" )",
              "RETURN",
              "    \"Ready homes\" & verb & FORMAT ( [Gross Yield (Ready)], \"0.0%\" ) & \" gross and \"",
              "        & FORMAT ( [Net Yield (Ready)], \"0.0%\" ) & \" net \" & periodPhrase",
              "        & \"; median rent AED \" & FORMAT ( [Median Rent per sqft], \"#,0\" ) & \" per sq ft\""
            ],
            "displayFolder": "Summaries",
            "lineageTag": "005d2fd3-c7ea-4562-afb2-3ee1c7fe6de5"
          },
          {
            "name": "Summary Who Builds",
            "expression": [
              "FORMAT ( [Active Projects], \"#,0\" ) & \" active projects with \" & FORMAT ( [Pipeline Units], \"#,0\" )",
              "    & \" homes in the pipeline; \" & FORMAT ( [Overdue Active Projects], \"#,0\" ) & \" are past their end date\""
            ],
            "displayFolder": "Summaries",
            "lineageTag": "09272d12-aebd-4d73-9787-975dc3663fbb"
          },
          {
            "name": "Area Projects",
            "expression": "CALCULATE ( COUNTROWS ( DIM_PROJECT ), TREATAS ( VALUES ( DIM_AREA[AREA_ID] ), DIM_PROJECT[AREA_ID] ) )",
            "formatString": "#,0",
            "displayFolder": "Area Profile",
            "lineageTag": "f3c8adf2-3d56-47b1-84cc-5a2ec8fb1e2e"
          },
          {
            "name": "Area Pipeline Units",
            "expression": "CALCULATE ( [Pipeline Units], TREATAS ( VALUES ( DIM_AREA[AREA_ID] ), DIM_PROJECT[AREA_ID] ) )",
            "formatString": "#,0",
            "displayFolder": "Area Profile",
            "lineageTag": "2a9e0d5f-089f-4a6a-adcc-96ef34d02822"
          },
          {
            "name": "Area Master Community",
            "expression": "COALESCE ( SELECTEDVALUE ( DIM_AREA[COMMUNITY_NAME] ), \"None dominant\" )",
            "displayFolder": "Area Profile",
            "lineageTag": "d4f37b2d-2a12-49fd-9d6d-ceb170b9458c"
          },
          {
            "name": "Area Official Name",
            "expression": "SELECTEDVALUE ( DIM_AREA[AREA_NAME_EN] )",
            "displayFolder": "Area Profile",
            "lineageTag": "cd092223-78e3-4859-a58a-0f38be86d67e"
          },
          {
            "name": "Area Top Developer",
            "expression": "IF ( HASONEVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ) && [Sales Count] > 0, MAXX ( TOPN ( 1, FILTER ( VALUES ( DIM_PROJECT[DEVELOPER_NAME] ), NOT ISBLANK ( DIM_PROJECT[DEVELOPER_NAME] ) ), [Sales Count], DESC ), DIM_PROJECT[DEVELOPER_NAME] ) )",
            "displayFolder": "Area Profile",
            "lineageTag": "5d84f0a2-8143-4cf6-9d95-2582a6aab619"
          },
          {
            "name": "Trend Yield Area",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Gross Yield (Ready)], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "0.0%",
            "displayFolder": "Trend",
            "lineageTag": "8b7f96ce-bd95-405f-8623-4c8fb0c2317c"
          },
          {
            "name": "Trend Yield Dubai",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Gross Yield (Ready)], REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_AREA ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "0.0%",
            "displayFolder": "Trend",
            "lineageTag": "b62b93d7-f22b-4f4b-9a84-c954370656ba"
          },
          {
            "name": "Trend Yield Selected Year",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && axisYear = SELECTEDVALUE ( DIM_DATE[YEAR] ), [Trend Yield Area] )",
            "formatString": "0.0%",
            "displayFolder": "Trend",
            "lineageTag": "21d0772a-0ca4-4793-a80c-40ac425b40ed"
          },
          {
            "name": "Summary Area Profile",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase = SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR areaPrice = [Median Price per sqft]",
              "VAR dubaiPrice = [Median Price per sqft Dubai]",
              "VAR gap = DIVIDE ( areaPrice, dubaiPrice ) - 1",
              "VAR verb = SWITCH ( tense, \"past\", \" sold \", \"current\", \" sell \", \" have sold \" )",
              "RETURN",
              "    IF ( NOT HASONEVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), \"Pick an area to see its profile\",",
              "         \"Priced \" & FORMAT ( ABS ( gap ), \"0%\" ) & IF ( gap >= 0, \" above\", \" below\" )",
              "             & \" the Dubai median \" & periodPhrase & \", on \" & FORMAT ( [Sales Count], \"#,0\" ) & \" sales\" )"
            ],
            "displayFolder": "Summaries",
            "lineageTag": "f5ed54fc-8b34-415c-a290-ee7806082c51"
          },
          {
            "name": "Title Area Facts",
            "expression": "IF ( HASONEVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), \"Fact sheet: \" & SELECTEDVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), \"Fact sheet\" )",
            "displayFolder": "Titles",
            "lineageTag": "404157be-ac56-474b-82c7-e6eba81f39b9"
          },
          {
            "name": "Title Area Top Projects",
            "expression": [
              "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] )",
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" )",
              "VAR periodPhrase = SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) )",
              "VAR projects = FILTER ( VALUES ( DIM_PROJECT[PROJECT_NAME_EN] ), NOT ISBLANK ( DIM_PROJECT[PROJECT_NAME_EN] ) )",
              "VAR best = TOPN ( 1, projects, [Sales Count], DESC )",
              "VAR nm = MAXX ( best, DIM_PROJECT[PROJECT_NAME_EN] )",
              "VAR n = MAXX ( best, [Sales Count] )",
              "VAR verb = SWITCH ( tense, \"past\", \" was \", \"current\", \" is \", \" has been \" )",
              "RETURN",
              "    IF ( ISBLANK ( nm ), \"Top projects\",",
              "         nm & verb & \"the busiest project \" & periodPhrase & \" (\" & FORMAT ( n, \"#,0\" ) & \" sales)\" )"
            ],
            "displayFolder": "Titles",
            "lineageTag": "1ae84f65-4801-448d-ba22-3fd58195fffc"
          },
          {
            "name": "Title Area Yield",
            "expression": [
              "VAR latestYr = YEAR ( [Last Data Date] )",
              "VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] )",
              "VAR yearToUse = IF ( isOneYear, SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr )",
              "VAR isPast = yearToUse < latestYr",
              "VAR nm = SELECTEDVALUE ( DIM_AREA[AREA_DISPLAY_NAME] )",
              "VAR areaYield = CALCULATE ( [Gross Yield (Ready)], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yearToUse )",
              "VAR dubaiYield = CALCULATE ( [Gross Yield (Ready)], REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_AREA ), DIM_DATE[YEAR] = yearToUse )",
              "RETURN",
              "    IF ( ISBLANK ( nm ) || ISBLANK ( areaYield ), \"Ready gross yield vs Dubai\",",
              "         \"Ready yield\" & IF ( isPast, \" was \", \" is \" ) & FORMAT ( areaYield, \"0.0%\" )",
              "             & \" in \" & yearToUse & \", vs \" & FORMAT ( dubaiYield, \"0.0%\" ) & \" for Dubai\" )"
            ],
            "displayFolder": "Titles",
            "lineageTag": "9dc28348-ab18-4f07-a4f3-85c2ea3bc5b9"
          },
          {
            "name": "Budget",
            "expression": "[Rent Budget Value]",
            "formatString": "#,0",
            "displayFolder": "Tenant",
            "lineageTag": "c9a818be-bfde-4929-a5fa-736773fe3d35"
          },
          {
            "name": "Within Budget",
            "expression": "IF ( [Market Rent Contracts] >= 10, IF ( [Median Annual Rent AED] <= [Budget], 1, 0 ) )",
            "formatString": "0",
            "displayFolder": "Tenant",
            "lineageTag": "7e98ef55-05ed-4fc7-a2ed-22de79a60a34"
          },
          {
            "name": "Largest Affordable Size",
            "expression": "VAR b = [Budget] VAR fits = FILTER ( ADDCOLUMNS (     FILTER ( VALUES ( FCT_RENT_CONTRACTS[ROOM_CATEGORY] ),              FCT_RENT_CONTRACTS[ROOM_CATEGORY] IN { \"Studio\", \"1 BR\", \"2 BR\", \"3 BR\", \"4 BR\", \"5+ BR\" } ),     \"@rent\", [Median Annual Rent AED], \"@n\", [Market Rent Contracts],     \"@order\", CALCULATE ( MAX ( FCT_RENT_CONTRACTS[ROOM_ORDER] ) ) ),   [@n] >= 10 && [@rent] <= b ) RETURN MAXX ( TOPN ( 1, fits, [@order], DESC ), FCT_RENT_CONTRACTS[ROOM_CATEGORY] )",
            "displayFolder": "Tenant",
            "lineageTag": "ce5bab8d-7b45-48e7-bf21-846311cf9437"
          },
          {
            "name": "Renewal Discount %",
            "expression": "DIVIDE ( [Median Renewal Rent per sqft] - [Median Rent per sqft], [Median Rent per sqft] )",
            "formatString": "0%",
            "displayFolder": "Tenant",
            "lineageTag": "f1f7fe85-1815-4a22-8bfe-771770fc8ccc"
          },
          {
            "name": "Budget Cell Color",
            "expression": "SWITCH ( [Within Budget], 1, \"#b8e0cf\", 0, \"#EEEEF0\" )",
            "displayFolder": "Tenant",
            "lineageTag": "c8636fbb-f6c7-4ba2-9d41-380f07ee5e91"
          },
          {
            "name": "Title Rent Heatmap",
            "expression": "VAR b = [Budget] VAR oneRoom = HASONEVALUE ( FCT_RENT_CONTRACTS[ROOM_CATEGORY] ) VAR roomName = SELECTEDVALUE ( FCT_RENT_CONTRACTS[ROOM_CATEGORY] ) VAR top15 = TOPN ( 15, CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), REMOVEFILTERS ( DIM_AREA ) ), [Market Rent Contracts], DESC ) VAR fitting = IF ( oneRoom,     COUNTROWS ( FILTER ( top15, [Within Budget] = 1 ) ),     COUNTROWS ( FILTER ( top15, NOT ISBLANK ( [Largest Affordable Size] ) ) ) ) RETURN IF ( oneRoom,     \"A \" & roomName & \" fits AED \" & FORMAT ( b, \"#,0\" ) & \" a year in \" & fitting & \" of the 15 busiest rental areas\",     \"AED \" & FORMAT ( b, \"#,0\" ) & \" a year gets you a home in \" & fitting & \" of the 15 busiest rental areas\" )",
            "displayFolder": "Titles",
            "lineageTag": "004a3679-a60b-4958-952e-c145845be774"
          },
          {
            "name": "Title Building Finder",
            "expression": "VAR areaName = IF ( HASONEVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), \" in \" & SELECTEDVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), \" in Dubai\" ) VAR buildings = FILTER ( ADDCOLUMNS (     FILTER ( VALUES ( DIM_PROJECT[PROJECT_NAME_EN] ), NOT ISBLANK ( DIM_PROJECT[PROJECT_NAME_EN] ) ),     \"@n\", [Market Rent Contracts], \"@sqft\", [Median Rent per sqft] ), [@n] >= 20 ) VAR busiest = TOPN ( 15, buildings, [@n], DESC ) VAR cheapest = TOPN ( 1, busiest, [@sqft], ASC ) RETURN IF ( COUNTROWS ( busiest ) = 0, \"Buildings\" & areaName,     MAXX ( cheapest, DIM_PROJECT[PROJECT_NAME_EN] ) & \" is the best value per sq ft among the busiest buildings\" & areaName )",
            "displayFolder": "Titles",
            "lineageTag": "e2b34810-83c1-4d06-bc92-92b6287e19b6"
          },
          {
            "name": "Trend Annual Rent Area",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), CALCULATE ( [Median Annual Rent AED], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear ) )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "6d13d605-6f77-400e-8808-6a8c2d39a11c"
          },
          {
            "name": "Trend Annual Rent Dubai",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Median Annual Rent AED], REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_AREA ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "8736bf4f-79a2-4fdd-99e6-d4607991212f"
          },
          {
            "name": "Trend Annual Rent Selected Year",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && axisYear = SELECTEDVALUE ( DIM_DATE[YEAR] ), COALESCE ( [Trend Annual Rent Area], [Trend Annual Rent Dubai] ) )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "0a68ccd5-8b57-478a-a7ed-44a980cc1909"
          },
          {
            "name": "Title Rent Trend",
            "expression": "VAR latestYr = YEAR ( [Last Data Date] ) VAR yr = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr ) VAR place = IF ( HASONEVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), SELECTEDVALUE ( DIM_AREA[AREA_DISPLAY_NAME] ), \"Dubai\" ) VAR nowRent = CALCULATE ( [Median Annual Rent AED], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr ) VAR thenRent = CALCULATE ( [Median Annual Rent AED], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr - 5 ) VAR g = DIVIDE ( nowRent, thenRent ) - 1 RETURN IF ( ISBLANK ( g ), \"Typical new-contract rent in \" & place, place & \": typical new rent \" & IF ( g >= 0, \"up \", \"down \" ) & FORMAT ( ABS ( g ), \"0%\" ) & \" in 5 years to \" & yr )",
            "displayFolder": "Titles",
            "lineageTag": "0b846466-4e8f-4f8f-a97e-097e3666fcd3"
          },
          {
            "name": "Summary Where to Rent",
            "expression": "VAR latestYr = YEAR ( [Last Data Date] ) VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] ) VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] ) VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" ) VAR periodPhrase = SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr, \"since 2010\" ) VAR verb = SWITCH ( tense, \"past\", \"paid\", \"current\", \"pay\", \"have paid\" ) VAR g = [Rent YoY %] RETURN \"New tenants \" & verb & \" a typical AED \" & FORMAT ( [Median Annual Rent AED], \"#,0\" ) & \" a year \" & periodPhrase & IF ( tense <> \"all\" && NOT ISBLANK ( g ), \", \" & IF ( g >= 0, \"up \", \"down \" ) & FORMAT ( ABS ( g ), \"0.0%\" ) & \" on \" & ( yr - 1 ), \"\" )",
            "displayFolder": "Summaries",
            "lineageTag": "5cde18f8-d001-45fb-9d94-081b8943cfbb"
          },
          {
            "name": "Launches",
            "expression": "CALCULATE ( COUNTROWS ( MART_PROJECT_ABSORPTION ), MART_PROJECT_ABSORPTION[IS_ABSORPTION_ELIGIBLE] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Absorption",
            "lineageTag": "70b009bd-0f5d-4c99-a00d-ac1ef6afca06"
          },
          {
            "name": "Launch Units",
            "expression": "CALCULATE ( SUM ( MART_PROJECT_ABSORPTION[NO_OF_UNITS] ), MART_PROJECT_ABSORPTION[IS_ABSORPTION_ELIGIBLE] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Absorption",
            "lineageTag": "69c220fe-2685-44bf-9fd6-8daa8c04e4ad"
          },
          {
            "name": "Median First-Year Absorption",
            "expression": "CALCULATE ( MEDIAN ( MART_PROJECT_ABSORPTION[FIRST_YEAR_ABSORPTION] ), MART_PROJECT_ABSORPTION[IS_ABSORPTION_ELIGIBLE] = TRUE () )",
            "formatString": "0%",
            "displayFolder": "Absorption",
            "lineageTag": "b12b57f9-6e73-4163-a056-822d7fb3a750"
          },
          {
            "name": "Median Months to Half Sold",
            "expression": "CALCULATE ( MEDIAN ( MART_PROJECT_ABSORPTION[MONTHS_TO_HALF_SOLD] ), MART_PROJECT_ABSORPTION[IS_ABSORPTION_ELIGIBLE] = TRUE () )",
            "formatString": "0",
            "displayFolder": "Absorption",
            "lineageTag": "b963768b-8f97-4dd7-aac1-99098f3e0eed"
          },
          {
            "name": "Sold 90% in Year One %",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( MART_PROJECT_ABSORPTION ), MART_PROJECT_ABSORPTION[IS_ABSORPTION_ELIGIBLE] = TRUE (), MART_PROJECT_ABSORPTION[FIRST_YEAR_ABSORPTION] >= 0.9 ), [Launches] )",
            "formatString": "0%",
            "displayFolder": "Absorption",
            "lineageTag": "1b0bcf5b-982b-43a2-9c76-9763131ede98"
          },
          {
            "name": "Latest Launch Year",
            "expression": "CALCULATE ( MAX ( MART_PROJECT_ABSORPTION[LAUNCH_YEAR] ), MART_PROJECT_ABSORPTION[IS_ABSORPTION_ELIGIBLE] = TRUE (), REMOVEFILTERS ( MART_PROJECT_ABSORPTION ) )",
            "formatString": "0",
            "displayFolder": "Absorption",
            "lineageTag": "baf001b5-f692-4bd7-ba5c-96088de14399"
          },
          {
            "name": "Latest Cohort Launches",
            "expression": "VAR y = [Latest Launch Year] RETURN CALCULATE ( [Launches], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] = y )",
            "formatString": "#,0",
            "displayFolder": "Absorption",
            "lineageTag": "ce1f2b87-12cb-47ba-937e-92c52a987a05"
          },
          {
            "name": "Latest Cohort Units",
            "expression": "VAR y = [Latest Launch Year] RETURN CALCULATE ( [Launch Units], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] = y )",
            "formatString": "#,0",
            "displayFolder": "Absorption",
            "lineageTag": "c80d3827-229c-46d5-907e-bf735fee8c9a"
          },
          {
            "name": "Latest Cohort Absorption",
            "expression": "VAR y = [Latest Launch Year] RETURN CALCULATE ( [Median First-Year Absorption], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] = y )",
            "formatString": "0%",
            "displayFolder": "Absorption",
            "lineageTag": "9afa828c-6738-4e2e-bd3b-fa7a74a15b5e"
          },
          {
            "name": "Latest Cohort Months to Half",
            "expression": "VAR y = [Latest Launch Year] RETURN CALCULATE ( [Median Months to Half Sold], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] = y )",
            "formatString": "0",
            "displayFolder": "Absorption",
            "lineageTag": "ca20a1fa-846f-4ff8-a8d5-91f4b4919941"
          },
          {
            "name": "Latest Cohort Absorption Change",
            "expression": "VAR y = [Latest Launch Year] VAR nowA = CALCULATE ( [Median First-Year Absorption], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] = y ) VAR prevA = CALCULATE ( [Median First-Year Absorption], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] = y - 1 ) RETURN IF ( NOT ISBLANK ( nowA ) && NOT ISBLANK ( prevA ), ( nowA - prevA ) * 100 )",
            "formatString": "+0 \"pts\";-0 \"pts\";0 \"pts\"",
            "displayFolder": "Absorption",
            "lineageTag": "c221bc0f-9e02-43c5-bc61-d48e73f51975"
          },
          {
            "name": "Summary How Fast It Sells",
            "expression": "VAR y = [Latest Launch Year] RETURN \"Projects launched in \" & y & \" sold a median \" & FORMAT ( [Latest Cohort Absorption], \"0%\" ) & \" of their units in their first year, \" & FORMAT ( ABS ( [Latest Cohort Absorption Change] ), \"0\" ) & \" points \" & IF ( [Latest Cohort Absorption Change] < 0, \"below\", \"above\" ) & \" the \" & ( y - 1 ) & \" cohort\"",
            "displayFolder": "Summaries",
            "lineageTag": "c307223d-0a40-4612-8583-64104d766611"
          },
          {
            "name": "Title Absorption Cohorts",
            "expression": "VAR yrs = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( MART_PROJECT_ABSORPTION[LAUNCH_YEAR] ),     MART_PROJECT_ABSORPTION[IS_ABSORPTION_ELIGIBLE] = TRUE () ),     \"@a\", [Median First-Year Absorption] ) VAR peak = TOPN ( 1, yrs, [@a], DESC ) VAR peakYear = MAXX ( peak, MART_PROJECT_ABSORPTION[LAUNCH_YEAR] ) VAR peakA = MAXX ( peak, [@a] ) VAR lastYear = [Latest Launch Year] VAR lastA = [Latest Cohort Absorption] RETURN \"First-year sales peaked at \" & FORMAT ( peakA, \"0%\" ) & \" for \" & peakYear & \" launches and have eased to \" & FORMAT ( lastA, \"0%\" ) & \" for \" & lastYear",
            "displayFolder": "Titles",
            "lineageTag": "514e17a9-f3a0-48b0-bbca-5487906f5445"
          },
          {
            "name": "Title Fastest Developers",
            "expression": "VAR devs = FILTER ( ADDCOLUMNS (     CALCULATETABLE ( VALUES ( MART_PROJECT_ABSORPTION[DEVELOPER_NAME] ), MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2021 ),     \"@n\", CALCULATE ( [Launches], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2021 ),     \"@u\", CALCULATE ( [Launch Units], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2021 ),     \"@a\", CALCULATE ( [Median First-Year Absorption], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2021 ),     \"@m\", CALCULATE ( [Median Months to Half Sold], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2021 ) ),   [@n] >= 5 && NOT ISBLANK ( MART_PROJECT_ABSORPTION[DEVELOPER_NAME] ) ) VAR biggest = TOPN ( 10, devs, [@u], DESC ) VAR fastest = TOPN ( 1, biggest, [@a], DESC, [@m], ASC, [@u], DESC ) RETURN \"Biggest launchers: \" & MAXX ( fastest, MART_PROJECT_ABSORPTION[DEVELOPER_NAME] ) & \" sells fastest, \" & FORMAT ( MAXX ( fastest, [@a] ), \"0%\" ) & \" in year 1\"",
            "displayFolder": "Titles",
            "lineageTag": "2e5d670d-ec1a-4522-96ad-f7bd15a8f947"
          },
          {
            "name": "Title Size vs Absorption",
            "expression": "VAR smallA = CALCULATE ( [Median First-Year Absorption], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2023, MART_PROJECT_ABSORPTION[NO_OF_UNITS] < 200 ) VAR bigA = CALCULATE ( [Median First-Year Absorption], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2023, MART_PROJECT_ABSORPTION[NO_OF_UNITS] >= 500 ) VAR gap = bigA - smallA RETURN IF ( ABS ( gap ) < 0.10,   \"Since 2023, size has made little difference: \" & FORMAT ( smallA, \"0%\" ) & \" sold in year 1 under 200 units, \" & FORMAT ( bigA, \"0%\" ) & \" at 500+\",   \"Since 2023, \" & IF ( gap > 0, \"larger\", \"smaller\" ) & \" launches sold faster: \" & FORMAT ( smallA, \"0%\" ) & \" under 200 units vs \" & FORMAT ( bigA, \"0%\" ) & \" at 500+\" )",
            "displayFolder": "Titles",
            "lineageTag": "ae6bc58c-5ad7-45af-8337-6eb7866d0797"
          },
          {
            "name": "Title Fastest Areas",
            "expression": "VAR areas = FILTER ( ADDCOLUMNS (     CALCULATETABLE ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2023 ),     \"@u\", CALCULATE ( [Launch Units], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2023 ),     \"@a\", CALCULATE ( [Median First-Year Absorption], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2023 ),     \"@m\", CALCULATE ( [Median Months to Half Sold], MART_PROJECT_ABSORPTION[LAUNCH_YEAR] >= 2023 ) ),   NOT ISBLANK ( [@u] ) ) VAR biggest = TOPN ( 6, areas, [@u], DESC ) VAR fastest = TOPN ( 1, biggest, [@a], DESC, [@m], ASC ) RETURN \"Busiest launch areas: \" & MAXX ( fastest, DIM_AREA[AREA_DISPLAY_NAME] ) & \" sells fastest, \" & FORMAT ( MAXX ( fastest, [@a] ), \"0%\" ) & \" in year 1\"",
            "displayFolder": "Titles",
            "lineageTag": "380623fd-1bef-4522-ac65-07dfd7fb2690"
          },
          {
            "name": "Home Finance Registrations",
            "expression": "CALCULATE ( COUNTROWS ( FCT_TRANSACTIONS ), FCT_TRANSACTIONS[FINANCE_CATEGORY] = \"Home finance\" )",
            "formatString": "#,0",
            "displayFolder": "Finance",
            "lineageTag": "1c938ef9-f27b-47b4-ae29-231ab35c78d9"
          },
          {
            "name": "Handover Mortgages",
            "expression": "CALCULATE ( COUNTROWS ( FCT_TRANSACTIONS ), FCT_TRANSACTIONS[PROCEDURE_NAME_EN] = \"Delayed Mortgage\" )",
            "formatString": "#,0",
            "displayFolder": "Finance",
            "lineageTag": "b29d993d-f8f0-468b-addc-6f9543faa0c5"
          },
          {
            "name": "Handover Share %",
            "expression": "DIVIDE ( [Handover Mortgages], [Home Finance Registrations] )",
            "formatString": "0%",
            "displayFolder": "Finance",
            "lineageTag": "2aeab266-d072-40b3-bfaa-12eab36134ca"
          },
          {
            "name": "Ready Sales",
            "expression": "CALCULATE ( COUNTROWS ( FCT_TRANSACTIONS ), FCT_TRANSACTIONS[IS_SALE] = TRUE (), FCT_TRANSACTIONS[IS_OFF_PLAN] = FALSE () )",
            "formatString": "#,0",
            "displayFolder": "Finance",
            "lineageTag": "637c8001-00a5-49b1-9abf-20713c0d23d1"
          },
          {
            "name": "Finance per 100 Ready Sales",
            "expression": "DIVIDE ( [Home Finance Registrations], [Ready Sales] ) * 100",
            "formatString": "0",
            "displayFolder": "Finance",
            "lineageTag": "1e94076d-34e3-45ae-92bc-d7a7cef875a2"
          },
          {
            "name": "Median Financed Value AED",
            "expression": "CALCULATE ( MEDIAN ( FCT_TRANSACTIONS[ACTUAL_WORTH_AED] ), FCT_TRANSACTIONS[FINANCE_CATEGORY] = \"Home finance\" )",
            "formatString": "#,0",
            "displayFolder": "Finance",
            "lineageTag": "e3084cf5-363a-4da9-9b65-e96d59e22c3b"
          },
          {
            "name": "Gift Transfers",
            "expression": "CALCULATE ( COUNTROWS ( FCT_TRANSACTIONS ), FCT_TRANSACTIONS[FINANCE_CATEGORY] = \"Gift\" )",
            "formatString": "#,0",
            "displayFolder": "Finance",
            "lineageTag": "4dfe692f-4889-4751-9bb5-db0680e9819f"
          },
          {
            "name": "Home Finance YoY %",
            "expression": "VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] ) VAR lastDt = [Last Data Date] VAR cur = [Home Finance Registrations] VAR prev = IF ( yr = YEAR ( lastDt ),     CALCULATE ( [Home Finance Registrations], REMOVEFILTERS ( DIM_DATE ),         DIM_DATE[DATE_DAY] >= DATE ( yr - 1, 1, 1 ), DIM_DATE[DATE_DAY] <= EDATE ( lastDt, -12 ) ),     CALCULATE ( [Home Finance Registrations], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr - 1 ) ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Finance",
            "lineageTag": "0ecef12a-50da-4a75-ad93-015779ad92ab"
          },
          {
            "name": "Summary How It's Financed",
            "expression": "VAR yrsWithSales = FILTER ( VALUES ( DIM_DATE[YEAR] ), [Sales Count] > 0 ) VAR isOneYear = HASONEVALUE ( DIM_DATE[YEAR] ) VAR yr = SELECTEDVALUE ( DIM_DATE[YEAR] ) VAR latestYr = YEAR ( [Last Data Date] ) VAR tense = IF ( isOneYear, IF ( yr < latestYr, \"past\", \"current\" ), \"all\" ) VAR periodPhrase = SWITCH ( tense, \"past\", \"in \" & yr, \"current\", \"so far in \" & yr, \"since \" & MINX ( yrsWithSales, DIM_DATE[YEAR] ) ) VAR verb = SWITCH ( tense, \"past\", \" were\", \"current\", \" have been\", \" have been\" ) RETURN FORMAT ( [Home Finance Registrations], \"#,0\" ) & \" home mortgages\" & verb & \" registered \" & periodPhrase & \", \" & FORMAT ( [Finance per 100 Ready Sales], \"0\" ) & \" for every 100 ready-home sales\"",
            "displayFolder": "Summaries",
            "lineageTag": "547fd59b-ac5d-47e3-9a2e-3ef3d99dfec5"
          },
          {
            "name": "Trend Finance Ratio",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Finance per 100 Ready Sales], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "0",
            "displayFolder": "Trend",
            "lineageTag": "3ed8a7fa-df4b-4530-9d86-d80e4c94d1d7"
          },
          {
            "name": "Trend Finance Ratio Selected Year",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && axisYear = SELECTEDVALUE ( DIM_DATE[YEAR] ), [Trend Finance Ratio] )",
            "formatString": "0",
            "displayFolder": "Trend",
            "lineageTag": "9b96cf3c-6725-4fa5-85e4-582f0c1815c8"
          },
          {
            "name": "Title Finance Ratio",
            "expression": "VAR latestYr = YEAR ( [Last Data Date] ) VAR yrs = ADDCOLUMNS ( FILTER ( ALL ( TREND_YEAR[YEAR] ), TREND_YEAR[YEAR] >= 2010 ),     \"@r\", VAR y = TREND_YEAR[YEAR] RETURN CALCULATE ( [Finance per 100 Ready Sales], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = y ) ) VAR low = TOPN ( 1, FILTER ( yrs, NOT ISBLANK ( [@r] ) ), [@r], ASC ) VAR lowYr = MAXX ( low, TREND_YEAR[YEAR] ) VAR lowR = MAXX ( low, [@r] ) VAR yr = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr ) VAR nowR = CALCULATE ( [Finance per 100 Ready Sales], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr ) VAR phrase = IF ( yr = latestYr, \" so far in \", \" in \" ) RETURN \"Mortgages per 100 ready sales fell to \" & FORMAT ( lowR, \"0\" ) & \" in the \" & lowYr & \" cash boom; \" & FORMAT ( nowR, \"0\" ) & phrase & yr",
            "displayFolder": "Titles",
            "lineageTag": "84eba2d4-75fc-43aa-80c2-0336b998915c"
          },
          {
            "name": "Title Finance Areas",
            "expression": "VAR areas = ADDCOLUMNS ( FILTER ( VALUES ( DIM_AREA[AREA_DISPLAY_NAME] ), NOT ISBLANK ( DIM_AREA[AREA_DISPLAY_NAME] ) ),     \"@n\", [Home Finance Registrations], \"@r\", [Finance per 100 Ready Sales], \"@s\", [Ready Sales] ) VAR topAreas = TOPN ( 8, areas, [@n], DESC ) VAR mostFinanced = TOPN ( 1, FILTER ( topAreas, [@s] >= 100 ), [@r], DESC ) RETURN MAXX ( mostFinanced, DIM_AREA[AREA_DISPLAY_NAME] ) & \" borrows most: \" & FORMAT ( MAXX ( mostFinanced, [@r] ), \"0\" ) & \" per 100 sales\"",
            "displayFolder": "Titles",
            "lineageTag": "aaf91e2c-d0d0-4cdc-844a-694a80e9ec47"
          },
          {
            "name": "Trend Home Finance",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Home Finance Registrations], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "64524c67-0488-4785-bc38-ca3a4a1c512e"
          },
          {
            "name": "Trend Ready Sales",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Ready Sales], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "4666546e-e50b-4356-bdf7-5db448b91ce4"
          },
          {
            "name": "Title Mortgages vs Ready Sales",
            "expression": "VAR latestYr = YEAR ( [Last Data Date] ) VAR yr = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr ) VAR nowM = CALCULATE ( [Home Finance Registrations], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr ) VAR thenM = CALCULATE ( [Home Finance Registrations], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr - 5 ) VAR nowS = CALCULATE ( [Ready Sales], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr ) VAR thenS = CALCULATE ( [Ready Sales], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr - 5 ) VAR isCurrent = yr = latestYr RETURN IF ( isCurrent,   \"So far in \" & yr & \": \" & FORMAT ( nowM, \"#,0\" ) & \" home mortgages against \" & FORMAT ( nowS, \"#,0\" ) & \" ready-home sales\",   \"Home mortgages grew \" & FORMAT ( DIVIDE ( nowM, thenM ), \"0.0\" ) & \"x in the 5 years to \" & yr & \", ready sales \" & FORMAT ( DIVIDE ( nowS, thenS ), \"0.0\" ) & \"x\" )",
            "displayFolder": "Titles",
            "lineageTag": "106fd518-e67b-43a8-8d5c-b8b0abc14bd4"
          },
          {
            "name": "Trend Gifts",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN CALCULATE ( [Gift Transfers], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = axisYear )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "1caa41e2-26a4-42df-9664-e8b84fe787c2"
          },
          {
            "name": "Trend Gifts Selected Year",
            "expression": "VAR axisYear = SELECTEDVALUE ( TREND_YEAR[YEAR] ) RETURN IF ( HASONEVALUE ( DIM_DATE[YEAR] ) && axisYear = SELECTEDVALUE ( DIM_DATE[YEAR] ), [Trend Gifts] )",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "f2adfd0c-ab97-456d-a4e8-2bfb2a32285b"
          },
          {
            "name": "Title Gifts",
            "expression": "VAR latestYr = YEAR ( [Last Data Date] ) VAR yr = IF ( HASONEVALUE ( DIM_DATE[YEAR] ), SELECTEDVALUE ( DIM_DATE[YEAR] ), latestYr - 1 ) VAR nowG = CALCULATE ( [Gift Transfers], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = yr ) VAR baseG = CALCULATE ( [Gift Transfers], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[YEAR] = 2010 ) RETURN IF ( yr = latestYr,   FORMAT ( nowG, \"#,0\" ) & \" property gifts so far in \" & yr,   \"Property gifts rose from \" & FORMAT ( baseG, \"#,0\" ) & \" in 2010 to \" & FORMAT ( nowG, \"#,0\" ) & \" in \" & yr )",
            "displayFolder": "Titles",
            "lineageTag": "f59a0437-4ee4-4705-b17a-35524c5ed1c3"
          },
          {
            "name": "Fcst Actual",
            "expression": "SUMX ( MART_FORECASTS, MART_FORECASTS[ACTUAL_VALUE] * MART_FORECASTS[UNIT_FACTOR] )",
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "11b33697-44e4-401a-8ef1-cd1dacc39e86"
          },
          {
            "name": "Fcst Forecast Value",
            "expression": "SUMX ( MART_FORECASTS, MART_FORECASTS[FORECAST_VALUE] * MART_FORECASTS[UNIT_FACTOR] )",
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "98de3e70-7727-4ee3-88d8-b609be7f2777"
          },
          {
            "name": "Fcst Low Value",
            "expression": "SUMX ( MART_FORECASTS, MART_FORECASTS[LOWER_BOUND] * MART_FORECASTS[UNIT_FACTOR] )",
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "5d453d15-ad6c-427c-9a4e-e7186629f587"
          },
          {
            "name": "Fcst High Value",
            "expression": "SUMX ( MART_FORECASTS, MART_FORECASTS[UPPER_BOUND] * MART_FORECASTS[UNIT_FACTOR] )",
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "96eb938b-0cb1-42ef-b325-22aada8709dc"
          },
          {
            "name": "Fcst Last Actual Month",
            "expression": "CALCULATE ( MAX ( MART_FORECASTS[MONTH_START] ), REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[IS_FORECAST] = FALSE () )",
            "formatString": "mmm yyyy",
            "displayFolder": "Forecast",
            "lineageTag": "3bd758ef-0aab-4087-a472-9bedac4599c9"
          },
          {
            "name": "Fcst Last Forecast Month",
            "expression": "CALCULATE ( MAX ( MART_FORECASTS[MONTH_START] ), REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[IS_FORECAST] = TRUE () )",
            "formatString": "mmm yyyy",
            "displayFolder": "Forecast",
            "lineageTag": "b8b198f9-ed72-419c-9f9e-a33e76976f31"
          },
          {
            "name": "Fcst Show Month",
            "expression": [
              "VAR m = MAX ( MART_FORECASTS[MONTH_START] )",
              "VAR d = [Fcst Last Actual Month]",
              "RETURN IF ( m >= EDATE ( d, -35 ), 1, 0 )"
            ],
            "formatString": "0",
            "displayFolder": "Forecast",
            "lineageTag": "00275ef5-d564-4c0c-bbcb-1c5553b7ce6c"
          },
          {
            "name": "Fcst Chart Forecast",
            "expression": [
              "VAR m = MAX ( MART_FORECASTS[MONTH_START] )",
              "VAR d = [Fcst Last Actual Month]",
              "RETURN IF ( HASONEVALUE ( MART_FORECASTS[MONTH_START] ) && m = d, [Fcst Actual], [Fcst Forecast Value] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "a5a255e1-9e6c-4119-ae43-5a64b466e921"
          },
          {
            "name": "Fcst Chart Low",
            "expression": [
              "VAR m = MAX ( MART_FORECASTS[MONTH_START] )",
              "VAR d = [Fcst Last Actual Month]",
              "RETURN IF ( HASONEVALUE ( MART_FORECASTS[MONTH_START] ) && m = d, [Fcst Actual], [Fcst Low Value] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "9e60a653-16cc-455b-b093-241fc90aa940"
          },
          {
            "name": "Fcst Chart High",
            "expression": [
              "VAR m = MAX ( MART_FORECASTS[MONTH_START] )",
              "VAR d = [Fcst Last Actual Month]",
              "RETURN IF ( HASONEVALUE ( MART_FORECASTS[MONTH_START] ) && m = d, [Fcst Actual], [Fcst High Value] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "f248e25b-0bf3-4151-ba16-5a44330b0021"
          },
          {
            "name": "Fcst Latest Value",
            "expression": [
              "VAR d = [Fcst Last Actual Month]",
              "RETURN CALCULATE ( [Fcst Actual], REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[MONTH_START] = d )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "7218c9f5-bded-4b47-ae6c-0e03ab844253"
          },
          {
            "name": "Fcst Last 12M Avg",
            "expression": [
              "VAR d = [Fcst Last Actual Month]",
              "RETURN CALCULATE ( AVERAGEX ( VALUES ( MART_FORECASTS[MONTH_START] ), [Fcst Actual] ), REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[MONTH_START] > EDATE ( d, -12 ), MART_FORECASTS[MONTH_START] <= d )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "c4ecff43-6492-4bd7-b97d-f3bbd624621c"
          },
          {
            "name": "Fcst Next 12M Avg",
            "expression": "CALCULATE ( AVERAGEX ( VALUES ( MART_FORECASTS[MONTH_START] ), [Fcst Forecast Value] ), REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[IS_FORECAST] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "8c6ef5a6-23f9-45f1-9203-8246970f9ce3"
          },
          {
            "name": "Fcst Change %",
            "expression": "DIVIDE ( [Fcst Next 12M Avg], [Fcst Last 12M Avg] ) - 1",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Forecast",
            "lineageTag": "c88010db-e16e-4318-a130-f7bb0f64e5d2"
          },
          {
            "name": "Fcst End Value",
            "expression": [
              "VAR e = [Fcst Last Forecast Month]",
              "RETURN CALCULATE ( [Fcst Forecast Value], REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[MONTH_START] = e )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "47d57637-db28-44f7-bba8-39a38b8e858d"
          },
          {
            "name": "Fcst End Low",
            "expression": [
              "VAR e = [Fcst Last Forecast Month]",
              "RETURN CALCULATE ( [Fcst Low Value], REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[MONTH_START] = e )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "862e1554-5135-4f6e-8267-3e657ec07b8d"
          },
          {
            "name": "Fcst End High",
            "expression": [
              "VAR e = [Fcst Last Forecast Month]",
              "RETURN CALCULATE ( [Fcst High Value], REMOVEFILTERS ( MART_FORECASTS[MONTH_START] ), MART_FORECASTS[MONTH_START] = e )"
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "f52bc680-4f48-4d01-936e-604fc3ab25f2"
          },
          {
            "name": "Fcst Range Text",
            "expression": "IF ( NOT ISBLANK ( [Fcst End Value] ), FORMAT ( [Fcst End Low], \"#,0\" ) & \" – \" & FORMAT ( [Fcst End High], \"#,0\" ) )",
            "displayFolder": "Forecast",
            "lineageTag": "a1794d5a-93ae-4390-8e29-1d6254de9eb9"
          },
          {
            "name": "Fcst Backtest Error",
            "expression": "SWITCH ( SELECTEDVALUE ( MART_FORECASTS[SERIES] ), \"Price per sq m\", 0.054, \"Rent per sq m\", 0.085, \"Sales per month\", 0.188 )",
            "formatString": "0.0%",
            "displayFolder": "Forecast",
            "lineageTag": "cd1e028d-86d8-4319-9f5f-224a5040801d"
          },
          {
            "name": "Fcst Confidence",
            "expression": [
              "VAR e = [Fcst Backtest Error]",
              "RETURN IF ( ISBLANK ( e ), BLANK (), IF ( e < 0.07, \"High\", IF ( e < 0.12, \"Medium\", \"Low\" ) ) )"
            ],
            "displayFolder": "Forecast",
            "lineageTag": "12fae4fe-f9f6-4bc0-af09-78e296b37588"
          },
          {
            "name": "Fcst Unit Label",
            "expression": "SWITCH ( SELECTEDVALUE ( MART_FORECASTS[SERIES] ), \"Price per sq m\", \"AED per sq ft\", \"Rent per sq m\", \"AED per sq ft / year\", \"Sales per month\", \"sales per month\" )",
            "displayFolder": "Forecast",
            "lineageTag": "a2c91224-91bc-4ec2-a0ef-1eec3e63000e"
          },
          {
            "name": "Title Forecast Chart",
            "expression": [
              "VAR l = SELECTEDVALUE ( MART_FORECASTS[SERIES_LABEL] )",
              "VAR c = [Fcst Change %]",
              "VAR dir = IF ( c >= 0.02, \"expected to rise\", IF ( c <= -0.02, \"expected to ease\", \"expected to hold steady\" ) )",
              "RETURN l & \": \" & dir & \", \" & FORMAT ( c, \"+0.0%;-0.0%;0.0%\" ) & \" vs last 12 months\""
            ],
            "displayFolder": "Forecast",
            "lineageTag": "0bd5049f-ff5b-4845-8b53-c7e3ca4f3b44"
          },
          {
            "name": "Title Forecast Table",
            "expression": "\"Next 12 months at a glance\"",
            "displayFolder": "Forecast",
            "lineageTag": "d7ef97be-8d2c-42c4-8340-77f98c3acb31"
          },
          {
            "name": "Summary Heading",
            "expression": [
              "",
              "VAR p = CALCULATE ( [Fcst Change %], REMOVEFILTERS ( MART_FORECASTS ), MART_FORECASTS[SERIES] = \"Price per sq m\" )",
              "VAR r = CALCULATE ( [Fcst Change %], REMOVEFILTERS ( MART_FORECASTS ), MART_FORECASTS[SERIES] = \"Rent per sq m\" )",
              "VAR s = CALCULATE ( [Fcst Change %], REMOVEFILTERS ( MART_FORECASTS ), MART_FORECASTS[SERIES] = \"Sales per month\" )",
              "VAR fmt = \"+0.0%;-0.0%;0.0%\"",
              "RETURN",
              "    \"Next 12 months vs last 12: prices \" & FORMAT ( p, fmt )",
              "        & \", rents \" & FORMAT ( r, fmt )",
              "        & \", sales \" & FORMAT ( s, fmt )",
              "        & \". Sales forecast is low confidence.\""
            ],
            "displayFolder": "Forecast",
            "lineageTag": "90db3f9c-0621-452b-bff1-6c6d8c71210a"
          },
          {
            "name": "Heatmap Annual Rent",
            "expression": [
              "",
              "IF ( [Market Rent Contracts] >= 10, [Median Annual Rent AED] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Rents",
            "lineageTag": "3acf877b-b915-46b6-b4a9-c47d3b7e06db",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          }
        ]
      },
