            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH (",
              "    MART_FORECASTS[SERIES],",
              "    \"Price per sq m\", \"Sale price\",",
              "    \"Rent per sq m\", \"Rent\",",
              "    \"Sales per month\", \"Sales\"",
              ")"
            ],
            "sortByColumn": "SERIES_ORDER",
            "lineageTag": "ac92a1a9-2bed-4cba-89c2-f1d1510b5323",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "SERIES_ORDER",
            "dataType": "int64",
            "isHidden": true,
            "expression": "SWITCH ( MART_FORECASTS[SERIES], \"Price per sq m\", 1, \"Rent per sq m\", 2, \"Sales per month\", 3 )",
            "lineageTag": "78501783-389a-49e8-99e4-583b47f181fa"
          },
          {
            "type": "calculated",
            "name": "UNIT_FACTOR",
            "dataType": "double",
            "isHidden": true,
            "expression": "IF ( MART_FORECASTS[SERIES] IN { \"Price per sq m\", \"Rent per sq m\" }, 1 / 10.7639, 1 )",
            "lineageTag": "254d4dff-7108-475e-8c00-4503209a90f6"
          }
        ],
