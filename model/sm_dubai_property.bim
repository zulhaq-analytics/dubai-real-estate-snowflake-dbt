      {
        "name": "_Measures",
        "lineageTag": "5c6507bc-d514-4652-bbc2-d71b86665184",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Value",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value]",
            "lineageTag": "534b6e65-b295-45d4-998f-0e37dd2cad8e"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "{ BLANK () }"
            }
          }
        ],
        "measures": [
          {
            "name": "Sales Count",
            "expression": "CALCULATE ( COUNTROWS ( FCT_TRANSACTIONS ), FCT_TRANSACTIONS[IS_SALE] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "81a82b92-95f5-458f-baa4-550cc640156f"
          },
          {
            "name": "Sales Value AED",
            "expression": "CALCULATE ( SUM ( FCT_TRANSACTIONS[ACTUAL_WORTH_AED] ), FCT_TRANSACTIONS[IS_SALE] = TRUE (), FCT_TRANSACTIONS[IS_PRICE_VALID] = TRUE () )",
            "formatString": "#,0.00",
            "displayFolder": "Sales",
            "lineageTag": "b855b1c7-8164-4144-a7a2-6b45b6d8c653"
          },
          {
            "name": "Off-Plan Share %",
            "expression": "DIVIDE ( CALCULATE ( [Sales Count], FCT_TRANSACTIONS[IS_OFF_PLAN] = TRUE () ), [Sales Count] )",
            "formatString": "0.0%",
            "displayFolder": "Sales",
            "lineageTag": "9a390a62-dc2b-4c8c-95b4-774602ab26df"
          },
          {
            "name": "Residential Sales (valid)",
            "expression": "CALCULATE ( COUNTROWS ( FCT_TRANSACTIONS ), FCT_TRANSACTIONS[IS_SALE] = TRUE (), FCT_TRANSACTIONS[IS_PRICE_VALID] = TRUE (), FCT_TRANSACTIONS[PROPERTY_USAGE_EN] = \"Residential\" )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "20b0baa0-b2d4-4767-86b6-b1d0e71bca1b"
          },
          {
            "name": "Ready Residential Sales (valid)",
            "expression": "CALCULATE ( [Residential Sales (valid)], FCT_TRANSACTIONS[IS_OFF_PLAN] = FALSE () )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "f185abd6-6786-48f7-8543-965e32a77c1f"
          },
          {
            "name": "Rent Contracts",
            "expression": "COUNTROWS ( FCT_RENT_CONTRACTS )",
            "formatString": "#,0",
            "displayFolder": "Rents",
            "lineageTag": "38dd2a9a-a60a-4a8d-91ac-130fb4c03f4a"
          },
          {
            "name": "Market Rent Contracts",
            "expression": "CALCULATE ( COUNTROWS ( FCT_RENT_CONTRACTS ), FCT_RENT_CONTRACTS[IS_NEW_CONTRACT] = TRUE (), FCT_RENT_CONTRACTS[IS_RENT_VALID] = TRUE (), FCT_RENT_CONTRACTS[IS_RESIDENTIAL] = TRUE (), FCT_RENT_CONTRACTS[IS_SINGLE_PROPERTY] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Rents",
            "lineageTag": "36e54c88-a37f-41de-b887-d6adc1e6a679"
          },
          {
            "name": "Median Annual Rent AED",
            "expression": "CALCULATE ( MEDIAN ( FCT_RENT_CONTRACTS[ANNUAL_RENT_AED] ), FCT_RENT_CONTRACTS[IS_NEW_CONTRACT] = TRUE (), FCT_RENT_CONTRACTS[IS_RENT_VALID] = TRUE (), FCT_RENT_CONTRACTS[IS_RESIDENTIAL] = TRUE (), FCT_RENT_CONTRACTS[IS_SINGLE_PROPERTY] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Rents",
            "lineageTag": "908b1e1a-e1ae-42af-8d99-84bbfa2aa757"
          },
          {
            "name": "Renewal Share %",
            "expression": "DIVIDE ( CALCULATE ( [Rent Contracts], FCT_RENT_CONTRACTS[IS_NEW_CONTRACT] = FALSE () ), [Rent Contracts] )",
            "formatString": "0.0%",
            "displayFolder": "Rents",
            "lineageTag": "64ff2d42-d2ce-471d-af6c-e7ead2ae3a0f"
          },
          {
            "name": "Service Charge Projects",
            "expression": "CALCULATE ( COUNTROWS ( FCT_SERVICE_CHARGES ), FCT_SERVICE_CHARGES[IS_LATEST_VALID_YEAR] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Service charges",
            "lineageTag": "221f5444-7f79-45d4-b0e9-2dca96a285da"
          },
          {
            "name": "Registered Units",
            "expression": "COUNTROWS ( DIM_UNIT )",
            "formatString": "#,0",
            "displayFolder": "Stock",
            "lineageTag": "ea63c6ed-a40d-462e-ae39-a262c9fe2013"
          },
          {
            "name": "Median Price per sqft",
            "expression": "DIVIDE ( CALCULATE ( MEDIAN ( FCT_TRANSACTIONS[PRICE_PER_SQM_AED] ), FCT_TRANSACTIONS[IS_SALE] = TRUE (), FCT_TRANSACTIONS[IS_PRICE_VALID] = TRUE (), FCT_TRANSACTIONS[PROPERTY_USAGE_EN] = \"Residential\" ), 10.7639 )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "9c907dfc-4386-48ce-9b94-8c613a5406c7"
          },
          {
            "name": "Median Ready Price per sqft",
            "expression": "CALCULATE ( [Median Price per sqft], FCT_TRANSACTIONS[IS_OFF_PLAN] = FALSE () )",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "lineageTag": "1649330e-1f87-4bde-b081-ed71213af41f"
          },
          {
            "name": "Median Rent per sqft",
            "expression": "DIVIDE ( CALCULATE ( MEDIAN ( FCT_RENT_CONTRACTS[RENT_PER_SQM_AED] ), FCT_RENT_CONTRACTS[IS_NEW_CONTRACT] = TRUE (), FCT_RENT_CONTRACTS[IS_RENT_VALID] = TRUE (), FCT_RENT_CONTRACTS[IS_RESIDENTIAL] = TRUE (), FCT_RENT_CONTRACTS[IS_SINGLE_PROPERTY] = TRUE () ), 10.7639 )",
            "formatString": "#,0.0",
            "displayFolder": "Rents",
            "lineageTag": "3a04b4cf-b631-421e-8d1b-7a939f6e40a5"
          },
          {
            "name": "Median Service Charge per sqft",
            "expression": "CALCULATE ( MEDIAN ( FCT_SERVICE_CHARGES[RATE_AED_PER_SQFT] ), FCT_SERVICE_CHARGES[IS_LATEST_VALID_YEAR] = TRUE () )",
            "formatString": "#,0.0",
            "displayFolder": "Service charges",
            "lineageTag": "43499f78-f53f-48c0-a460-b19d45b879f6"
          },
          {
            "name": "Median Valuation per sqft",
            "expression": "DIVIDE ( CALCULATE ( MEDIAN ( FCT_VALUATIONS[VALUE_PER_SQM_AED] ), FCT_VALUATIONS[IS_VALUE_VALID] = TRUE () ), 10.7639 )",
            "formatString": "#,0",
            "displayFolder": "Valuations",
            "lineageTag": "9d194e1f-9d36-46eb-9f48-c2d0e361d798"
          },
          {
            "name": "Gross Yield",
            "expression": "IF ( [Residential Sales (valid)] >= 30 && [Market Rent Contracts] >= 30, DIVIDE ( [Median Rent per sqft], [Median Price per sqft] ) )",
            "formatString": "0.00%",
            "displayFolder": "Yield",
            "lineageTag": "3d368395-2502-4fb8-bcf0-6ae188d248ba"
          },
          {
            "name": "Gross Yield (Ready)",
            "expression": "IF ( [Ready Residential Sales (valid)] >= 30 && [Market Rent Contracts] >= 30, DIVIDE ( [Median Rent per sqft], [Median Ready Price per sqft] ) )",
            "formatString": "0.00%",
            "displayFolder": "Yield",
            "lineageTag": "ca8d8ab4-e6b0-425d-84cb-0a624fdf42aa"
          },
          {
            "name": "Net Yield (Ready)",
            "expression": "IF ( NOT ISBLANK ( [Gross Yield (Ready)] ) && [Service Charge Projects] >= 5, DIVIDE ( [Median Rent per sqft] - [Median Service Charge per sqft], [Median Ready Price per sqft] ) )",
            "formatString": "0.00%",
            "displayFolder": "Yield",
            "lineageTag": "43d18777-43f4-412f-9fe6-b18482cb765b"
          },
          {
            "name": "Dirham Symbol White",
            "expression": "\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 344.84 299.91'><path fill='%23FFFFFF' d='M342.14,140.96l2.7,2.54v-7.72c0-17-11.92-30.84-26.56-30.84h-23.41C278.49,36.7,222.69,0,139.68,0c-52.86,0-59.65,0-109.71,0,0,0,15.03,12.63,15.03,52.4v52.58h-27.68c-5.38,0-10.43-2.08-14.61-6.01l-2.7-2.54v7.72c0,17.01,11.92,30.84,26.56,30.84h18.44s0,29.99,0,29.99h-27.68c-5.38,0-10.43-2.07-14.61-6.01l-2.7-2.54v7.71c0,17,11.92,30.82,26.56,30.82h18.44s0,54.89,0,54.89c0,38.65-15.03,50.06-15.03,50.06h109.71c85.62,0,139.64-36.96,155.38-104.98h32.46c5.38,0,10.43,2.07,14.61,6l2.7,2.54v-7.71c0-17-11.92-30.83-26.56-30.83h-18.9c.32-4.88.49-9.87.49-15s-.18-10.11-.51-14.99h28.17c5.37,0,10.43,2.07,14.61,6.01ZM89.96,15.01h45.86c61.7,0,97.44,27.33,108.1,89.94l-153.96.02V15.01ZM136.21,284.93h-46.26v-89.98l153.87-.02c-9.97,56.66-42.07,88.38-107.61,90ZM247.34,149.96c0,5.13-.11,10.13-.34,14.99l-157.04.02v-29.99l157.05-.02c.22,4.84.33,9.83.33,15Z'/></svg>\"",
            "displayFolder": "Icons",
            "lineageTag": "b63438fd-0bbe-4d85-ab24-05edad5bf046",
            "dataCategory": "ImageUrl"
          },
          {
